---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/global/Navbar.astro'
import Hero from '../components/react/IntroHero'
import StatsBar from '../components/section/StatsBar.astro'
import TextWithImage from '../components/section/TextWithImage.astro'
import BrandTabs from '../components/react/BrandTab'
import { getPage } from '../lib/data/pages'
import ProductGrid from '../components/section/ProductGrid.astro'
import Banner from '../components/section/Banner.astro'
import type { BannerBlock } from '../lib/data/blocks/banner'
import type { ProductGridBlock } from '../lib/data/blocks/product-grid'
import type { HeroBlock, StatsBarBlock } from '../lib/data/blocks'
import type { TextWithImageBlock } from '../lib/data/blocks/text-with-image'
import type { BrandTabsBlock } from '../lib/data/blocks/brand-tab'

const page = await getPage('home')
const blocks = page?.blocks ?? []
const heroBlock = blocks.find((b: any) => b.blockType === 'hero') as HeroBlock | undefined
const statsBlock = blocks.find((b: any) => b.blockType === 'statsBar') as StatsBarBlock | undefined
const twiBlock = blocks.find((b: any) => b.blockType === 'text-with-image') as
  | TextWithImageBlock
  | undefined
const brandTabsBlock = blocks.find((b: any) => b.blockType === 'brand-tabs') as
  | BrandTabsBlock
  | undefined
const restBlocks = blocks.filter(
  (b: any) => !['hero', 'statsBar', 'text-with-image', 'brand-tabs'].includes(b.blockType)
)
---

<Layout>
  <Navbar variant="transparent" scrollBehavior="scroll-to-white" />
  <div class="relative">
    {heroBlock && (
      <div class="min-h-svh bg-black">
        <Hero client:only="react" {...heroBlock} videoUrl={heroBlock.video?.url} />
      </div>
    )}
    {statsBlock && <StatsBar items={statsBlock.items} />}
    <div class="bg-[url('/bg.png')] bg-cover bg-center">
      {twiBlock && <TextWithImage {...twiBlock} />}
      {brandTabsBlock && <BrandTabs client:load {...brandTabsBlock} />}
    </div>
    {
      restBlocks.map((block: any) => {
        switch (block.blockType) {
          case 'product-grid':
            return <ProductGrid {...(block as ProductGridBlock)} />
          case 'banner':
            return <Banner {...(block as BannerBlock)}/>
          default:
            return null
        }
      })
    }
  </div>
</Layout>
