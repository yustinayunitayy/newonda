---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/global/Navbar.astro'
import Hero from '../components/react/IntroHero'
import { getPage } from '../lib/data/pages'
import type { HeroBlock } from '../lib/data/pages'

const page = await getPage('home')

const heroBlock = page?.blocks.find((b) => b.blockType === 'hero') as HeroBlock | undefined

const videoUrl = heroBlock?.video?.streamUid
  ? `https://customer-${import.meta.env.CF_CUSTOMER}.cloudflarestream.com/${heroBlock.video.streamUid}/downloads/default.mp4`
  : undefined
---

<Layout>
  <Navbar variant="transparent" />
  {heroBlock && <Hero client:only="react" {...heroBlock} videoUrl={videoUrl} />}
</Layout>
