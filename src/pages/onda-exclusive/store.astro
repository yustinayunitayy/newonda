---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/global/Navbar.astro'
import StoreLocator from '../../components/react/Store'
import { getStores } from '../../lib/data/oe-store'

const stores = await getStores()
---

<Layout footerVariant="black">
  <Navbar variant="black" />
  <main class="pt-16">
    <StoreLocator client:load stores={stores} />
  </main>
</Layout>
