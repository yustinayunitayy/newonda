---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/global/Navbar.astro'
import CatalogueViewer from '../../components/react/CatalogueViewer'
import { getCatalogs } from '../../lib/data/catalog'
const catalogs = await getCatalogs()
---

<Layout
  title="Katalog Produk — ONDA Sanitary & Plumbing"
  description="Temukan seluruh katalog ONDA Group — dari ONDA, Onda Valve, hingga koleksi Onda Exclusive. Lihat dan unduh di sini"
>
  <Navbar variant="white" />
  <main>
    <section class="section pt-16 md:pt-24">
      <div class="mb-8">
        <p class="text-mini-label text-onda-blue">Katalog Produk</p>
        <h1 class="text-h2 text-onda-blue mt-1 font-extrabold">Jelajahi Katalog Produk Onda</h1>
        <p class="text-body text-dark-blue-shade mt-1">
          Jelajahi dan unduh katalog lengkap ONDA Group — kran, shower, valve, water meter, hingga
          koleksi premium ONDA Exclusive.
        </p>
      </div>
    </section>
    <CatalogueViewer client:load catalogs={catalogs} storeUrl="https://store-onda.id" />
  </main>
</Layout>
