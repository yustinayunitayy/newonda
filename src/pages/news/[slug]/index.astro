---
import Layout from '../../../layouts/Layout.astro'
import Navbar from '../../../components/global/Navbar.astro'
import { RichTextRenderer } from '../../../components/react/RichTextRenderer'
import { getNewsBySlug, formatNewsDate } from '../../../lib/data/onda-news'
import { img } from '../../../lib/image'

export const prerender = false

const { slug } = Astro.params
const news = slug ? await getNewsBySlug(slug) : null

if (!news) {
  return Astro.redirect('/404')
}
---

<Layout title={`${news.title} — ONDA`} description={news.preview ?? news.subtitle}>
  <Navbar variant="white" />
  <main class="min-h-screen bg-white pt-16">
    <div class="section py-8">
      <a
        href="/news"
        class="text-onda-blue hover:text-onda-blue/80 group inline-flex items-center gap-2 transition-colors"
      >
        <iconify-icon
          icon="mdi:arrow-left"
          width="20"
          class="transition-transform group-hover:-translate-x-1"></iconify-icon>
        <span class="font-medium">Back to News</span>
      </a>
    </div>

    <div class="section pt-0 pb-8">
      <div class="mx-auto max-w-4xl">
        {
          news.coverUrl && (
            <div class="mb-8 overflow-hidden rounded-lg">
              <img
                src={img(news.coverUrl, 1200)}
                alt={news.title}
                class="h-64 w-full object-cover md:h-80 lg:h-96"
                loading="eager"
              />
            </div>
          )
        }

        <h1 class="text-onda-blue mb-4 text-xl font-bold md:text-2xl lg:text-3xl">
          {news.title}
        </h1>

        {
          news.subtitle && (
            <h2 class="text-onda-blue/80 mb-6 text-lg font-semibold md:text-xl">{news.subtitle}</h2>
          )
        }

        <div class="text-dark-blue-shade/70 mb-6 flex items-center gap-2">
          <iconify-icon icon="mdi:calendar" width="20"></iconify-icon>
          <span class="text-sm md:text-base">{formatNewsDate(news.date)}</span>
        </div>

        {
          news.categories.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {news.categories.map((c) => (
                <span class="bg-light-blue-shade text-onda-blue rounded-full px-3 py-1 text-sm font-semibold">
                  {c.name}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </div>

    {/* Body */}
    <div class="section pt-0 pb-16">
      <div class="mx-auto max-w-4xl">
        <RichTextRenderer content={news.description} className="text-dark-blue-shade" />
      </div>
    </div>
  </main>
</Layout>

<script is:inline src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
