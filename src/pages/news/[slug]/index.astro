---
import Layout from '../../../layouts/Layout.astro'
import Navbar from '../../../components/global/Navbar.astro'
import { RichTextRenderer } from '../../../components/react/RichTextRenderer'
import { getNewsBySlug, formatNewsDate } from '../../../lib/data/onda-news'
import { img } from '../../../lib/image'

export const prerender = false

const { slug } = Astro.params
const news = slug ? await getNewsBySlug(slug) : null

if (!news) return Astro.rewrite('/404')

const base = Astro.site?.href ?? 'https://onda.id/'
const pageUrl = new URL(Astro.url.pathname, base).href

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: news.title,
  description: news.preview ?? '',
  image: news.coverUrl ? [img(news.coverUrl, 1200)] : undefined,
  datePublished: news.date,
  dateModified: news.date,
  author: { '@id': `${base}#organization` },
  publisher: { '@id': `${base}#organization` },
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  inLanguage: 'id-ID',
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: base },
    { '@type': 'ListItem', position: 2, name: 'Berita', item: new URL('/news', base).href },
    { '@type': 'ListItem', position: 3, name: news.title, item: pageUrl },
  ],
}
---

<Layout title={`${news.title} — ONDA Sanitary & Plumbing`} description={news.preview}>
  <Navbar variant="white" />
  <main class="min-h-screen bg-white pt-16">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

    <div class="section py-8">
      <a
        href="/news"
        class="text-onda-blue hover:text-onda-blue/80 group inline-flex items-center gap-2 transition-colors"
      >
        <iconify-icon
          icon="mdi:arrow-left"
          width="20"
          class="transition-transform group-hover:-translate-x-1"></iconify-icon>
        <span class="font-medium">Kembali ke Berita</span>
      </a>
    </div>

    <div class="section pt-0 pb-8">
      <div class="mx-auto flex max-w-4xl flex-col gap-4">
        {
          news.coverUrl && (
            <div class="mb-4 overflow-hidden rounded-lg">
              <img
                src={img(news.coverUrl, 1200)}
                alt={news.title}
                class="h-64 w-full object-cover md:h-80 lg:h-96"
                loading="eager"
              />
            </div>
          )
        }

        <h1 class="text-onda-blue text-h2 font-extrabold">{news.title}</h1>

        <div class="text-dark-blue-shade/70 flex items-center gap-2">
          <iconify-icon icon="mdi:calendar" width="20"></iconify-icon>
          <span class="text-body">{formatNewsDate(news.date)}</span>
        </div>

        {
          news.categories.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {news.categories.map((c) => (
                <span class="bg-light-blue-shade text-onda-blue text-mini-label inline-block rounded-md px-2.5 py-0.5 font-semibold">
                  {c.name}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <div class="section pt-0 pb-16">
      <div class="mx-auto max-w-4xl">
        <RichTextRenderer content={news.description} className="text-dark-blue-shade" />
      </div>
    </div>
  </main>
</Layout>
