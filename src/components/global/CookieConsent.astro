---
import type { PrivacyPolicyData } from '../../lib/data/blocks/cookie'
import { RichTextRenderer } from '../react/RichTextRenderer'

type Props = NonNullable<PrivacyPolicyData['banner']>

const MODE: 'implied' | 'strict' = 'strict'
const { text, acceptLabel = 'Terima', rejectLabel = 'Tolak' } = Astro.props
---

<div id="cookie-consent" data-mode={MODE} class="fixed inset-x-0 bottom-0 z-[55] hidden">
  <div
    class="cc-card border-onda-blue/10 w-full border-t bg-white shadow-[0_-8px_30px_rgba(0,0,0,0.08)]"
  >
    <div class="section flex flex-col gap-4 py-4 md:flex-row md:items-center md:gap-10 md:py-6">
      <div
        class="[&_p]:text-dark-blue-shade/80 flex-1 text-xs leading-relaxed sm:text-sm [&_p]:mb-0 [&_p]:text-xs [&_p]:leading-relaxed sm:[&_p]:text-sm"
      >
        {
          text ? (
            <RichTextRenderer content={text} />
          ) : (
            <p>
              Kami menggunakan cookie untuk membantu meningkatkan pengalaman Anda, menganalisis
              penggunaan website, dan memastikan website berfungsi dengan baik. Dengan melanjutkan
              penggunaan website, Anda menyetujui penggunaan cookie sesuai dengan{' '}
              <a href="/privacy-policy" class="text-onda-blue font-semibold underline">
                Kebijakan Privasi
              </a>
            </p>
          )
        }
      </div>
      <div class="flex flex-none items-center gap-3">
        <button
          id="cc-reject"
          type="button"
          class="border-onda-blue text-onda-blue hover:bg-onda-blue/5 rounded-lg border px-5 py-2.5 text-sm font-semibold transition-colors"
        >
          {rejectLabel}
        </button>
        <button
          id="cc-accept"
          type="button"
          class="bg-onda-blue rounded-lg px-6 py-2.5 text-sm font-bold text-white transition hover:brightness-110"
        >
          {acceptLabel}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes ccIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .cc-card {
    animation: ccIn 0.45s ease-out both;
  }
  @media (prefers-reduced-motion: reduce) {
    .cc-card {
      animation: none;
    }
  }
</style>

<script>
  const el = document.getElementById('cookie-consent')
  if (el) {
    const KEY = 'onda_consent'
    const mode = el.dataset.mode
    const SHOW_DELAY = 3000
    const w = window as any
    w.dataLayer = w.dataLayer || []

    function gtag(..._args: any[]) {
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments)
    }

    const grant = () => {
      gtag('consent', 'update', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted',
      })
      w.dataLayer.push({ event: 'consent_granted' })
    }

    const floating = () => document.getElementById('to-top')?.parentElement as HTMLElement | null
    const lift = () => {
      const f = floating()
      if (f) f.style.bottom = el.offsetHeight + 16 + 'px'
    }
    const unlift = () => {
      const f = floating()
      if (f) f.style.bottom = ''
      window.removeEventListener('resize', lift)
    }

    const hide = () => {
      el.classList.add('hidden')
      el.classList.remove('flex')
      unlift()
    }

    let cleanup = () => {}
    const decide = (v: 'granted' | 'denied') => {
      try {
        localStorage.setItem(KEY, v)
      } catch {}
      if (v === 'granted') grant()
      hide()
      cleanup()
    }

    let stored: string | null = null
    try {
      stored = localStorage.getItem(KEY)
    } catch {}

    if (stored === 'granted') {
      grant()
    } else if (stored !== 'denied') {
      const showTimer = setTimeout(() => {
        el.classList.remove('hidden')
        el.classList.add('flex')
        lift()
        window.addEventListener('resize', lift)

        document.getElementById('cc-accept')?.addEventListener('click', () => decide('granted'))
        document.getElementById('cc-reject')?.addEventListener('click', () => decide('denied'))

        if (mode === 'implied') {
          const scrollHandler = () => {
            if (window.scrollY > 300) decide('granted')
          }
          const clickHandler = (e: MouseEvent) => {
            if (!el.contains(e.target as Node)) decide('granted')
          }
          const t = setTimeout(() => {
            window.addEventListener('scroll', scrollHandler, { passive: true })
            document.addEventListener('click', clickHandler)
          }, 1500)
          cleanup = () => {
            clearTimeout(t)
            window.removeEventListener('scroll', scrollHandler)
            document.removeEventListener('click', clickHandler)
          }
        }
      }, SHOW_DELAY)
      cleanup = () => clearTimeout(showTimer)
    }
  }
</script>
