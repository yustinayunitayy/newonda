---
import { Image } from 'astro:assets'
import LogoWhite from '../../assets/LogoWhite.png'
import LogoBlue from '../../assets/Logo.png'
import { getNavigation } from '../../lib/data/navbar'
import { Icon } from 'astro-icon/components'

interface Props {
  variant?: 'transparent' | 'white'
}

const { variant = 'white' } = Astro.props
const nav = await getNavigation('official')
const menu = nav?.menu ?? []

const NavStyle = {
  transparent: {
    nav: 'bg-transparent',
    text: 'text-white hover:font-bold',
  },
  white: {
    nav: 'bg-white',
    text: 'text-onda-blue hover:text-dark-blue-shade',
  },
}

const s = NavStyle[variant]
const currentPath = Astro.url.pathname
---

<header
  id="navbar"
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 shadow-md  ${s.nav}`}
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-7 md:px-0">
    <!-- Desktop -->
    <a href="/">
      {
        variant === 'transparent' ? (
          <Image src={LogoWhite} alt="ONDA Logo" class="h-8 w-auto" />
        ) : (
          <Image src={LogoBlue} alt="ONDA Logo" class="h-8 w-auto" />
        )
      }
    </a>
    <ul class="hidden items-center gap-6 lg:flex">
      {
        menu.map((item) => {
          const isActive =
            item.link === '/' ? currentPath === '/' : currentPath.startsWith(item.link ?? '')
          return (
            <li>
              <a
                href={item.link}
                class:list={[
                  'text-sm font-medium transition-all',
                  s.text,
                  { 'font-semibold underline': isActive },
                ]}
                target={item.link?.startsWith('http') ? '_blank' : undefined}
                rel={item.link?.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        })
      }
    </ul>

    <!-- Mobile -->
    <button
      id="hamburger"
      class={`lg:hidden p-2 ${variant === 'transparent' ? 'text-white' : 'text-onda-blue'}`}
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <Icon name="lucide:menu" id="icon-menu" class="h-6 w-6" />
      <Icon name="lucide:x" id="icon-close" class="hidden h-6 w-6" />
    </button>
  </nav>
</header>
<!-- Mobile Sidebar -->
<div id="drawer" class="pointer-events-none fixed inset-0 z-50 lg:hidden">
  <!-- Overlay nutup seluruh layar -->
  <div
    id="drawer-overlay"
    class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"
  >
  </div>
  <div
    id="drawer-panel"
    class="absolute top-0 bottom-0 left-0 w-72 -translate-x-full bg-white shadow-xl transition-transform duration-300"
  >
    <div class="flex h-16 items-center border-b border-gray-100 px-4">
      <a href="/" id="drawer-logo">
        <Image src={LogoBlue} alt="ONDA Logo" class="h-8 w-auto" loading="eager" />
      </a>
    </div>
    <ul class="flex flex-col gap-1 p-4">
      {
        menu.map((item) => (
          <li>
            <a
              href={item.link}
              class="text-onda-blue hover:bg-onda-blue block rounded-lg px-4 py-2 text-sm font-medium transition-all hover:text-white"
              target={item.link?.startsWith('http') ? '_blank' : undefined}
              rel={item.link?.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const hamburger = document.getElementById('hamburger')
  const drawer = document.getElementById('drawer')
  const overlay = document.getElementById('drawer-overlay')
  const panel = document.getElementById('drawer-panel')
  const iconMenu = document.getElementById('icon-menu')
  const iconClose = document.getElementById('icon-close')

  let isOpen = false

  function openDrawer() {
    isOpen = true
    drawer!.classList.remove('pointer-events-none')
    overlay!.classList.replace('opacity-0', 'opacity-100')
    panel!.classList.replace('-translate-x-full', 'translate-x-0')
    iconMenu!.classList.add('hidden')
    iconClose!.classList.remove('hidden')
    hamburger!.setAttribute('aria-expanded', 'true')
  }

  function closeDrawer() {
    isOpen = false
    drawer!.classList.add('pointer-events-none')
    overlay!.classList.replace('opacity-100', 'opacity-0')
    panel!.classList.replace('translate-x-0', '-translate-x-full')
    iconMenu!.classList.remove('hidden')
    iconClose!.classList.add('hidden')
    hamburger!.setAttribute('aria-expanded', 'false')
  }

  hamburger?.addEventListener('click', () => (isOpen ? closeDrawer() : openDrawer()))
  overlay?.addEventListener('click', closeDrawer)
  document.getElementById('drawer-logo')?.addEventListener('click', closeDrawer)
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && isOpen) closeDrawer()
  })
</script>
