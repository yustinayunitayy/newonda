---
import { Image } from 'astro:assets'
import LogoWhite from '../../assets/LogoWhite.png'
import LogoBlue from '../../assets/Logo.png'
import { getNavigation } from '../../lib/data/navbar'
import { Icon } from 'astro-icon/components'

interface Props {
  variant?: 'transparent' | 'white' | 'black'
  scrollBehavior?: 'static' | 'scroll-to-white'
}

const { variant = 'white', scrollBehavior = 'static' } = Astro.props
const nav = await getNavigation('official')
const menu = nav?.menu ?? []

const NavStyle = {
  transparent: {
    nav: 'bg-transparent',
    text: 'text-white hover:font-bold',
  },
  white: {
    nav: 'bg-white',
    text: 'text-onda-blue hover:text-dark-blue-shade hover:font-bold',
  },
  black: {
    nav: 'bg-black',
    text: 'text-white hover:font-bold',
  },
}

const s = NavStyle[variant]
const currentPath = Astro.url.pathname

const extAttrs = (link?: string) =>
  link?.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}
---

<header
  id="navbar"
  data-variant={variant}
  data-scroll-behavior={scrollBehavior}
  class={`fixed top-0 left-0 right-0 z-50 -translate-y-full opacity-0 pointer-events-none transition-all duration-500 ${s.nav}`}
>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-7 md:px-0">
    <!-- Logo -->
    <a href="/">
      <Image
        id="logo-white"
        src={LogoWhite}
        alt="ONDA Logo"
        class:list={['h-8 w-auto', variant === 'transparent' ? 'block' : 'hidden']}
      />
      <Image
        id="logo-blue"
        src={LogoBlue}
        alt="ONDA Logo"
        class:list={['h-8 w-auto', variant === 'white' ? 'block' : 'hidden']}
      />
    </a>

    <!-- Desktop -->
    <ul class="hidden items-center gap-6 lg:flex">
      {
        menu.map((item) => {
          const isActive =
            item.link === '/' ? currentPath === '/' : currentPath.startsWith(item.link ?? '')
          return (
            <li>
              <a
                href={item.link}
                class:list={[
                  'nav-link text-sm font-medium transition-all',
                  s.text,
                  { 'font-semibold underline': isActive },
                ]}
                {...extAttrs(item.link)}
              >
                {item.label}
              </a>
            </li>
          )
        })
      }
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="hamburger"
      class:list={['p-2 lg:hidden', variant === 'transparent' ? 'text-white' : 'text-onda-blue']}
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <Icon name="lucide:menu" id="icon-menu" class="h-6 w-6" />
      <Icon name="lucide:x" id="icon-close" class="hidden h-6 w-6" />
    </button>
  </nav>
</header>

<!-- Mobile Sidebar -->
<div id="drawer" class="pointer-events-none fixed inset-0 z-50 lg:hidden">
  <div
    id="drawer-overlay"
    class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"
  >
  </div>
  <div
    id="drawer-panel"
    class="absolute top-0 bottom-0 left-0 w-72 -translate-x-full bg-white shadow-xl transition-transform duration-300"
  >
    <div class="flex h-16 items-center border-b border-gray-100 px-4">
      <a href="/" id="drawer-logo">
        <Image src={LogoBlue} alt="ONDA Logo" class="h-8 w-auto" loading="eager" />
      </a>
    </div>
    <ul class="flex flex-col gap-1 p-4">
      {
        menu.map((item) => (
          <li>
            <a
              href={item.link}
              class="text-onda-blue hover:bg-onda-blue block rounded-lg px-4 py-2 text-sm font-medium transition-all hover:text-white"
              {...extAttrs(item.link)}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const $ = (id: string) => document.getElementById(id)!
  const navbar = $('navbar')
  const logoWhite = $('logo-white')
  const logoBlue = $('logo-blue')
  const hamburger = $('hamburger')
  const drawer = $('drawer')
  const overlay = $('drawer-overlay')
  const panel = $('drawer-panel')
  const iconMenu = $('icon-menu')
  const iconClose = $('icon-close')

  const VARIANTS = {
    transparent: {
      nav: ['bg-transparent'],
      text: ['text-white', 'hover:font-bold'],
      hamburger: 'text-white',
      whiteLogo: true,
    },
    white: {
      nav: ['bg-white', 'shadow-sm'],
      text: ['text-onda-blue', 'hover:text-dark-blue-shade'],
      hamburger: 'text-onda-blue',
      whiteLogo: false,
    },
    black: {
      nav: ['bg-black', 'shadow-sm'],
      text: ['text-white', 'hover:font-bold'],
      hamburger: 'text-white',
      whiteLogo: true,
    },
  }

  type VariantName = keyof typeof VARIANTS

  const initialVariant = navbar.dataset.variant as VariantName
  const scrollBehavior = navbar.dataset.scrollBehavior

  function applyVariant(name: VariantName) {
    const v = VARIANTS[name]
    const other = name === 'white' ? VARIANTS.transparent : VARIANTS.white

    navbar.classList.remove(...other.nav)
    navbar.classList.add(...v.nav)

    logoWhite.classList.toggle('hidden', !v.whiteLogo)
    logoBlue.classList.toggle('hidden', v.whiteLogo)

    hamburger.classList.remove(other.hamburger)
    hamburger.classList.add(v.hamburger)

    document.querySelectorAll('.nav-link').forEach((el) => {
      el.classList.remove(...other.text)
      el.classList.add(...v.text)
    })
  }

  if (scrollBehavior === 'scroll-to-white') {
    const onScroll = () => applyVariant(window.scrollY > 20 ? 'white' : initialVariant)
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()
  }

  function setDrawer(open: boolean) {
    drawer.classList.toggle('pointer-events-none', !open)
    overlay.classList.toggle('opacity-100', open)
    overlay.classList.toggle('opacity-0', !open)
    panel.classList.toggle('translate-x-0', open)
    panel.classList.toggle('-translate-x-full', !open)
    iconMenu.classList.toggle('hidden', open)
    iconClose.classList.toggle('hidden', !open)
    hamburger.setAttribute('aria-expanded', String(open))
  }

  const isOpen = () => !drawer.classList.contains('pointer-events-none')

  hamburger.addEventListener('click', () => setDrawer(!isOpen()))
  overlay.addEventListener('click', () => setDrawer(false))
  $('drawer-logo')?.addEventListener('click', () => setDrawer(false))
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && isOpen()) setDrawer(false)
  })
</script>
