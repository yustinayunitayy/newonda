---
import type { SiteSettings } from '../../lib/data/site-settings'

interface Props {
  settings: SiteSettings | null
}
const { settings } = Astro.props
const waNumber = settings?.contact?.csPhone?.replace(/\D/g, '')
const waText = encodeURIComponent('Halo ONDA, saya ingin bertanya tentang produk.')
---

<div class="fixed right-5 bottom-5 z-40 flex flex-col items-center gap-3">
  <!-- Back to top -->
  <button
    id="to-top"
    type="button"
    aria-label="Kembali ke atas"
    class="bg-onda-blue pointer-events-none flex h-12 w-12 translate-y-2 items-center justify-center rounded-full text-white opacity-0 shadow-lg transition-all duration-300 hover:brightness-110"
  >
    <iconify-icon icon="mdi:chevron-up" width="28"></iconify-icon>
  </button>

  <!-- WhatsApp -->
  {
    waNumber && (
      <a
        href={`https://wa.me/${waNumber}?text=${waText}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat WhatsApp CS ONDA"
        class="wa-reveal flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105"
      >
        <iconify-icon icon="mdi:whatsapp" width="32" />
      </a>
    )
  }
</div>

<script>
  const btn = document.getElementById('to-top')
  if (btn) {
    const toggle = () => {
      const show = window.scrollY > 400
      btn.classList.toggle('opacity-0', !show)
      btn.classList.toggle('translate-y-2', !show)
      btn.classList.toggle('pointer-events-none', !show)
    }
    window.addEventListener('scroll', toggle, { passive: true })
    toggle()
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
  }
</script>

<style>
  @keyframes waIn {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .wa-reveal {
    animation: waIn 0.5s ease-out 2s both;
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-reveal {
      animation: none;
    }
  }
</style>
