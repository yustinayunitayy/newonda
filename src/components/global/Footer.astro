---
import type { SiteSettings } from '../../lib/data/site-settings'
import { img } from '../../lib/image'

interface Props {
  settings: SiteSettings
  variant?: 'blue' | 'black'
}

const { settings, variant = 'blue' } = Astro.props
const bg = variant === 'black' ? 'bg-black' : 'bg-onda-blue'
const { logo, headOffice, contact, socialMedia = [], onlineShop = [], copyright } = settings
const waNumber = contact?.csPhone?.replace(/\D/g, '')
---

<footer class:list={[bg, 'text-white']}>
  <div class="section py-10 md:py-12">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-8 xl:grid-cols-4">
      {
        logo?.url && (
          <img
            src={img(logo.url, 300)}
            alt={logo.alt ?? 'ONDA'}
            class="h-5 w-auto self-start md:col-span-2 md:h-9 lg:col-span-1 lg:h-11 lg:self-center"
          />
        )
      }
      {
        headOffice?.address && (
          <div class="max-w-xs">
            <h3 class="text-base font-bold">Kantor Pusat</h3>
            <p class="mt-2 text-sm leading-relaxed whitespace-pre-line text-white/85">
              {headOffice.address}
            </p>
          </div>
        )
      }
      {
        (contact?.phone || contact?.csPhone || contact?.email) && (
          <div>
            <h3 class="text-base font-bold">Kontak Kami</h3>
            <ul class="mt-3 flex flex-col gap-3 text-sm text-white/85">
              {contact?.phone && (
                <li class="flex items-center gap-3">
                  <iconify-icon icon="mdi:phone" width="18" />
                  <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
                </li>
              )}
              {contact?.csPhone && (
                <li class="flex items-center gap-3">
                  <iconify-icon icon="mdi:whatsapp" width="18" />
                  <a href={`https://wa.me/${waNumber}`} target="_blank" rel="noopener noreferrer">
                    {contact.csPhone}
                  </a>
                </li>
              )}
              {contact?.email && (
                <li class="flex items-center gap-3">
                  <iconify-icon icon="mdi:email-outline" width="18" />
                  <a href={`mailto:${contact.email}`}>{contact.email}</a>
                </li>
              )}
            </ul>
          </div>
        )
      }
      <div class="flex flex-col gap-6">
        {
          socialMedia.length > 0 && (
            <div>
              <h3 class="text-base font-bold">Social Media</h3>
              <div class="mt-3 flex flex-wrap gap-3">
                {socialMedia.map((s) => (
                  <a
                    href={s.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.platform}
                    class="flex h-10 w-10 items-center justify-center rounded-full border border-white/60 transition-colors hover:bg-white/15"
                  >
                    <iconify-icon icon={s.icon} width="22" />
                  </a>
                ))}
              </div>
            </div>
          )
        }

        {
          onlineShop.length > 0 && (
            <div>
              <h3 class="text-base font-bold">E-Commerce</h3>
              <div class="mt-3 flex flex-wrap gap-3">
                {onlineShop.map((s) => (
                  <a
                    href={s.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.platform}
                    class="flex h-10 w-10 items-center justify-center rounded-full border border-white/70 transition-colors hover:bg-white/15"
                  >
                    <iconify-icon icon={s.icon} width="22" />
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
    <hr class="mt-10 border-white/20" />
    <div
      class="mt-5 flex flex-col items-center gap-2 text-sm text-white/80 sm:flex-row sm:justify-between"
    >
      {copyright && <p>{copyright}</p>}
      <nav class="flex gap-5">
        <a href="/privacy-policy" class="transition-colors hover:text-white hover:underline">
          Kebijakan Privasi
        </a>
        <a href="/snk-garansi" class="transition-colors hover:text-white hover:underline">
          S&K Garansi
        </a>
      </nav>
    </div>
  </div>
</footer>
