---
// src/components/global/Footer.astro
// Narik dari collection `site-settings` (pakai fetchSiteSettings).

import type { SiteSettings } from '../../lib/data/site-settings' // sesuaikan path

interface Props {
  settings: SiteSettings
}

const { settings } = Astro.props
const { logo, headOffice, contact, socialMedia = [], onlineShop = [], copyright } = settings
const waNumber = contact?.csPhone?.replace(/\D/g, '')
---

<footer class="bg-onda-blue text-white">
  <div class="mx-auto max-w-7xl px-6 py-10 md:px-12 md:py-12">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between md:gap-8">
      {
        logo?.url && (
          <img
            src={logo.url}
            alt={logo.alt ?? 'ONDA'}
            class="h-9 w-auto self-start md:h-11 md:self-center"
          />
        )
      }

      {
        headOffice?.address && (
          <div class="max-w-xs">
            <h3 class="text-base font-bold">Kantor Pusat</h3>
            <p class="mt-2 text-sm leading-relaxed whitespace-pre-line text-white/85">
              {headOffice.address}
            </p>
          </div>
        )
      }

      {
        (contact?.phone || contact?.csPhone || contact?.email) && (
          <div>
            <h3 class="text-base font-bold">Kontak Kami</h3>
            <ul class="mt-3 flex flex-col gap-3 text-sm text-white/85">
              {contact?.phone && (
                <li class="flex items-center gap-3">
                  <iconify-icon icon="mdi:phone" width="18" />
                  <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
                </li>
              )}
              {contact?.csPhone && (
                <li class="flex items-center gap-3">
                  <iconify-icon icon="mdi:whatsapp" width="18" />
                  <a href={`https://wa.me/${waNumber}`} target="_blank" rel="noopener noreferrer">
                    {contact.csPhone}
                  </a>
                </li>
              )}
              {contact?.email && (
                <li class="flex items-center gap-3">
                  <iconify-icon icon="mdi:email-outline" width="18" />
                  <a href={`mailto:${contact.email}`}>{contact.email}</a>
                </li>
              )}
            </ul>
          </div>
        )
      }

      <div class="flex flex-col gap-6">
        {
          socialMedia.length > 0 && (
            <div>
              <h3 class="text-base font-bold">Social Media</h3>
              <div class="mt-3 flex flex-wrap gap-3">
                {socialMedia.map((s) => (
                  <a
                    href={s.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.platform}
                    class="flex h-9 w-9 items-center justify-center rounded-full border border-white/60 transition-colors hover:bg-white/15"
                  >
                    <iconify-icon icon={s.icon} width="18" />
                  </a>
                ))}
              </div>
            </div>
          )
        }

        {
          onlineShop.length > 0 && (
            <div>
              <h3 class="text-base font-bold">E-Commerce</h3>
              <div class="mt-3 flex flex-wrap gap-3">
                {onlineShop.map((s) => (
                  <a
                    href={s.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.platform}
                    class="flex h-10 w-10 items-center justify-center rounded-full border border-white/70 transition-colors hover:bg-white/15"
                  >
                    <iconify-icon icon={s.icon} width="22" />
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>

    <hr class="mt-10 border-white/20" />
    {copyright && <p class="mt-5 text-center text-sm text-white/80">{copyright}</p>}
  </div>
</footer>

<script is:inline src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
