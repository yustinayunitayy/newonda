---
import { Image } from 'astro:assets'
import LogoBlue from '../../assets/Logo.png'
import LogoWhite from '../../assets/LogoWhite.png'

interface Props {
  isHome?: boolean
  variant?: 'default' | 'exclusive'
}

const { isHome = false, variant = 'default' } = Astro.props
const isExclusive = variant === 'exclusive'
---

<div
  id="global-loader"
  data-is-home={isHome ? '1' : '0'}
  class:list={[
    'fixed inset-0 z-9999 grid place-items-center transition-opacity duration-500 ease-out',
    isExclusive ? 'bg-black' : 'bg-white',
  ]}
>
  <div class="flex flex-col items-center gap-5">
    <Image
      src={isExclusive ? LogoWhite : LogoBlue}
      alt="ONDA"
      class="h-10 w-auto"
      loading="eager"
    />
    <span
      class:list={[
        'h-10 w-10 animate-spin rounded-full border-4',
        isExclusive
          ? 'border-t-onda-yellow border-white/20'
          : 'border-onda-blue/30 border-t-onda-blue',
      ]}></span>
  </div>
</div>

<script is:inline>
  ;(function () {
    var loader = document.getElementById('global-loader')
    if (!loader) return

    var isHome = loader.dataset.isHome === '1'
    var introSeen = sessionStorage.getItem('intro-seen') === 'true'

    var html = document.documentElement
    html.style.overflow = 'hidden'

    var done = false
    function hide() {
      if (done) return
      done = true
      html.style.overflow = ''
      loader.style.opacity = '0'
      loader.style.pointerEvents = 'none'
      setTimeout(function () {
        loader.remove()
      }, 500)
    }

    if (isHome && !introSeen) {
      window.addEventListener('hero:mounted', hide, { once: true })
      setTimeout(hide, 4000)
      return
    }

    if (document.readyState === 'complete') hide()
    else window.addEventListener('load', hide, { once: true })
  })()
</script>
