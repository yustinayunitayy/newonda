---
import { fetchSiteSettings } from '../../lib/data/site-settings'

const site = await fetchSiteSettings()
const { title, description } = Astro.props

const base = Astro.site?.href ?? 'https://onda.id/'
const url = new URL(Astro.url.pathname, base).href

const clean = (obj: unknown) =>
  JSON.parse(
    JSON.stringify(obj, (_, v) =>
      v === '' || v == null || v === false || (Array.isArray(v) && v.length === 0) ? undefined : v
    )
  )

const jsonLd = clean({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${base}#organization`,
      name: 'ONDA Sanitary & Plumbing',
      url: base,
      logo: site?.logo?.url,
      address: site?.headOffice?.address && {
        '@type': 'PostalAddress',
        streetAddress: site.headOffice.address,
        addressCountry: 'ID',
      },
      contactPoint: (site?.contact?.phone || site?.contact?.email) && {
        '@type': 'ContactPoint',
        telephone: site?.contact?.phone,
        email: site?.contact?.email,
        contactType: 'customer service',
      },
      sameAs: site?.socialMedia?.map((s: any) => s.link),
    },
    {
      '@type': 'WebSite',
      '@id': `${base}#website`,
      url: base,
      name: 'ONDA Sanitary & Plumbing',
      publisher: { '@id': `${base}#organization` },
      inLanguage: 'id-ID',
    },
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: title,
      description,
      isPartOf: { '@id': `${base}#website` },
      about: { '@id': `${base}#organization` },
      inLanguage: 'id-ID',
    },
  ],
})
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
