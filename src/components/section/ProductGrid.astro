---
import type { ProductGridBlock } from '../../lib/data/blocks/product-grid'

type Props = ProductGridBlock

const { miniLabel, heading, subheading, items } = Astro.props
---

<section class="px-10 py-16 md:px-24 md:py-24">
  <!-- Section header -->
  {
    (miniLabel || heading || subheading) && (
      <div class="mb-10 flex flex-col gap-2">
        {miniLabel && (
          <p class="text-onda-blue text-xs font-semibold tracking-widest uppercase">{miniLabel}</p>
        )}
        {heading && (
          <h2 class="text-onda-blue text-xl leading-tight font-bold md:text-4xl">{heading}</h2>
        )}
        {subheading && <p class="text-base text-gray-500">{subheading}</p>}
      </div>
    )
  }

  <!-- Grid: 2 col mobile, 4 col desktop -->
  <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5">
    {
      items.map((item) => (
        <div class="group relative aspect-[3/4] overflow-hidden rounded-2xl bg-gray-100">
          <img
            src={`${item.image.url}?quality=85&width=600`}
            alt={item.image.alt ?? item.label ?? ''}
            class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
            loading="lazy"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-transparent" />

          <div class="absolute right-0 bottom-0 left-0 p-4 md:p-5">
            {item.label && (
              <p class="text-xs font-semibold tracking-wide text-white uppercase md:text-sm">
                {item.label}
              </p>
            )}
            {item.description && (
              <p class="mt-1 translate-y-1 text-xs leading-relaxed text-white/80 opacity-0 transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100 md:text-sm">
                {item.description}
              </p>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
