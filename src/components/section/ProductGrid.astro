---
import type { ProductGridBlock } from '../../lib/data/blocks/product-grid'

type Props = ProductGridBlock

const { miniLabel, heading, subheading, items } = Astro.props
---

<section class="section">
  {
    (miniLabel || heading || subheading) && (
      <div class="mb-8 flex flex-col gap-3 md:mb-12" data-reveal-group>
        {miniLabel && <p class="text-mini-label">{miniLabel}</p>}
        {heading && <h2 class="text-h2 text-onda-blue">{heading}</h2>}
        {subheading && <p class="text-lead text-dark-blue-shade max-w-2xl">{subheading}</p>}
      </div>
    )
  }

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6" data-reveal-group>
    {
      items.map((item) => (
        <article class="group relative aspect-3/4 overflow-hidden rounded-2xl">
          {item.image?.url && (
            <img
              src={`${item.image.url}?quality=85&width=600`}
              alt={item.image.alt ?? item.label ?? ''}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          )}

          <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/15 to-transparent" />

          <div class="absolute inset-x-0 bottom-0 p-4 md:p-5">
            {item.label && (
              <h3 class="text-h3 font-bold tracking-wide text-white uppercase">{item.label}</h3>
            )}
            {item.description && (
              <p class="text-body mt-1 text-white/85 transition-all duration-300 lg:translate-y-2 lg:opacity-0 lg:group-hover:translate-y-0 lg:group-hover:opacity-100">
                {item.description}
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
