---
import type { CertificationsBlock } from '../../lib/data/blocks/about'
import { resolveColor } from '../../lib/colour'
import AwardsCarousel from '../react/Awards'
import { img } from '../../lib/image'

type Props = CertificationsBlock

const {
  heading,
  headingTextColor = 'blue',
  subheading,
  subheadingTextColor = 'darkBlue',
  awardsHeading,
  awards = [],
  certsHeading,
  certs = [],
  warrantyBadge,
} = Astro.props
---

<section class="section to-light-blue-shade bg-linear-to-b from-white pb-16">
  <!-- Header -->
  {
    (heading || subheading) && (
      <div class="mb-12 text-center">
        {heading && (
          <h2
            class="text-h2 font-extrabold"
            style={`color:${resolveColor(headingTextColor, 'blue')}`}
            data-reveal
          >
            {heading}
          </h2>
        )}
        {subheading && (
          <p
            class="text-body mt-3 leading-relaxed"
            style={`color:${resolveColor(subheadingTextColor, 'darkBlue')}`}
            data-reveal
          >
            {subheading}
          </p>
        )}
      </div>
    )
  }

  <!-- Penghargaan (carousel) -->
  {
    awards.length > 0 && (
      <div>
        <p class="text-onda-blue text-mini-label mb-6 text-center font-bold tracking-[0.2em] uppercase">
          – {awardsHeading} –
        </p>
        <AwardsCarousel client:visible awards={awards} />
      </div>
    )
  }

  <!-- Sertifikasi -->
  {
    certs.length > 0 && (
      <div class="mt-14" data-reveal-group>
        <p class="text-onda-blue text-mini-label mb-6 text-center font-bold tracking-[0.2em] uppercase">
          – {certsHeading} –
        </p>
        <div class="grid gap-4 md:grid-cols-3 md:gap-6">
          {certs.map((c) => (
            <div class="flex items-start gap-4 rounded-2xl bg-white p-5 shadow-[0_10px_30px_rgba(0,93,166,0.08)]">
              <div class="shadow-onda-blue/20 flex h-12 w-12 flex-none items-center justify-center overflow-hidden rounded-xl bg-white shadow-md">
                {c.image?.url ? (
                  <img
                    src={img(c.image.url, 400)}
                    alt={c.title}
                    class="h-8 w-8 object-contain"
                    loading="lazy"
                  />
                ) : (
                  <iconify-icon icon="mdi:certificate-outline" class="text-onda-blue" width="24" />
                )}
              </div>
              <div>
                <h3 class="text-onda-blue text-h4 font-bold">{c.title}</h3>
                {c.description && (
                  <p class="text-dark-blue-shade/70 mt-1 text-sm leading-relaxed">
                    {c.description}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <!-- Badge Garansi -->
  {
    warrantyBadge && (
      <div
        class="bg-dark-blue-shade mt-10 flex flex-col items-start gap-4 rounded-2xl p-6 text-white sm:flex-row sm:items-center sm:gap-8 md:p-8"
        data-reveal
      >
        <div class="flex-none text-center">
          <div class="text-4xl leading-none font-extrabold md:text-5xl">
            {warrantyBadge.years ?? 10}
          </div>
          <div class="text-sm font-bold tracking-widest">TAHUN</div>
        </div>
        <div>
          {warrantyBadge.heading && <p class="text-h4 font-bold">{warrantyBadge.heading}</p>}
          {warrantyBadge.caption && (
            <p class="text-body mt-1 leading-relaxed text-white/85">{warrantyBadge.caption}</p>
          )}
        </div>
      </div>
    )
  }
</section>
