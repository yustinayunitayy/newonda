---
import type { SiteSettings } from '../../lib/data/site-settings'
import Hero from '../react/Hero'
import HeroCarousel from '../react/HeroCarousel'
import BrandTabs from '../react/BrandTab'
import BrandVideoGrid from '../react/BrandVideo'
import StatsBar from '../section/StatsBar.astro'
import TextWithImage from '../section/TextWithImage.astro'
import ProductGrid from '../section/ProductGrid.astro'
import Banner from '../section/Banner.astro'
import FAQ from '../section/Faq.astro'
import Newsletter from '../section/Newsletter.astro'
import InfoCards from '../section/InfoCards.astro'
import Timeline from '../section/Timeline.astro'
import Certification from '../section/Certification.astro'
import ContactForm from '../section/ContactForm.astro'
import PartnershipForm from '../section/PartnershipForm.astro'
import { STREAM_BASE, toBrandVideoItems } from '../../lib/data/brand-video'

interface Props {
  blocks: any[]
  settings?: SiteSettings
  formVariant?: 'contact' | 'partnership'
}

const { blocks, settings, formVariant = 'contact' } = Astro.props
---

{
  blocks.map((block: any) => {
    switch (block.blockType) {
      case 'hero':
        return <Hero client:load {...block} videoUrl={block.video?.url} />
      case 'hero-carousel':
        return <HeroCarousel client:visible {...block} />
      case 'statsBar':
        return <StatsBar {...block} />
      case 'text-with-image':
        return <TextWithImage {...block} />
      case 'brand-tabs':
        return <BrandTabs client:load {...block} />
      case 'product-grid':
        return <ProductGrid {...block} />
      case 'banner':
        return <Banner {...block} />
      case 'faq-accordion':
        return <FAQ {...block} />
      case 'newsletter':
        return <Newsletter {...block} />
      case 'info-cards':
        return <InfoCards {...block} />
      case 'timeline':
        return <Timeline {...block} />
      case 'certifications':
        return <Certification {...block} />
      case 'brand-video-grid':
        return (
          <BrandVideoGrid
            client:visible
            heading={block.heading}
            headingColor={block.headingColor}
            videos={toBrandVideoItems(block.videos)}
            streamBase={STREAM_BASE}
          />
        )
      case 'form-wording':
        return formVariant === 'partnership' ? (
          <PartnershipForm {...block} settings={settings} />
        ) : (
          <ContactForm {...block} settings={settings} />
        )
      default:
        return null
    }
  })
}