---
import type { MitraStepsBlock } from '../../lib/data/blocks/about'

type Props = MitraStepsBlock
const { heading = '3 langkah jadi mitra ONDA', steps = [] } = Astro.props
---

<section class="section">
  <h3 class="text-h3 text-center font-bold text-white">{heading}</h3>

  <div
    class="mt-8 flex flex-col items-center gap-6 md:flex-row md:items-start md:justify-center md:gap-4"
  >
    {
      steps.map((s, i) => (
        <Fragment>
          <div class="w-full max-w-xs text-center md:max-w-none md:flex-1" data-reveal>
            <span class="bg-onda-yellow text-dark-blue-shade mx-auto flex h-12 w-12 items-center justify-center rounded-full text-lg font-extrabold">
              {i + 1}
            </span>
            <h4 class="text-body mt-3 font-bold text-white">{s.title}</h4>
            {s.description && (
              <p class="text-button mt-1 leading-relaxed text-white/70">{s.description}</p>
            )}
          </div>

          {i < steps.length - 1 && (
            <div
              class="flex shrink-0 items-center justify-center text-white/40 md:mt-3"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6 rotate-90 md:rotate-0"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </div>
          )}
        </Fragment>
      ))
    }
  </div>
</section>
