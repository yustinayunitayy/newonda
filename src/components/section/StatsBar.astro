---
type Props = {
  items: { value: string; label: string }[]
}

const { items } = Astro.props
---

<div
  id="stats-bar"
  class="invisible relative z-10 -mt-12 translate-y-8 px-6 opacity-0 transition-[opacity,transform] duration-700 ease-out"
>
  <div class="overflow-hidden rounded-2xl bg-white py-7 shadow-xl">
    <div class="marquee-track grid auto-cols-fr grid-flow-col">
      {
        items.map((item, i) => (
          <div
            data-marquee-item
            class:list={[
              'shrink-0 px-10 text-center',
              i < items.length - 1 && 'border-onda-blue/20 border-r',
            ]}
          >
            <p class="text-onda-blue mb-1 text-lg font-bold md:text-2xl">{item.value}</p>

            <p class="text-onda-blue text-xs tracking-[0.12em] uppercase">{item.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { initMarquee } from '../../utils/marquee'

  initMarquee('.marquee-track')

  const el = document.getElementById('stats-bar')
  const alreadySeen = sessionStorage.getItem('intro-seen')

  if (el) {
    if (alreadySeen) {
      el.classList.remove('opacity-0', 'translate-y-8', 'invisible')

      el.classList.add('opacity-100', 'translate-y-0', 'visible')
    } else {
      setTimeout(() => {
        el.classList.remove('opacity-0', 'translate-y-8', 'invisible')

        el.classList.add('opacity-100', 'translate-y-0', 'visible')
      }, 6800)
    }
  }
</script>
