---
type Props = {
  items: { value: string; label: string }[]
}
const { items } = Astro.props
const useMarquee = items.length > 4
---

<div
  id="stats-bar"
  class="invisible relative z-10 -mt-12 translate-y-8 px-6 opacity-0 transition-[opacity,transform] duration-700 ease-out"
>
  <div class="overflow-hidden rounded-2xl border border-blue-100 bg-white py-7 shadow-xl">
    <div class={useMarquee ? 'marquee-track flex w-max' : 'grid grid-cols-4'}>
      {
        [...items, ...items].map((item, i) => (
          <div
            data-marquee-item
            class:list={[
              'shrink-0 px-10 text-center',
              !useMarquee && i < items.length - 1 && 'border-onda-blue/20 border-r',
              useMarquee && 'border-onda-blue/20 border-r',
            ]}
          >
            <p class="text-onda-blue mb-1 text-xl font-bold">{item.value}</p>
            <p class="text-onda-blue text-[0.65rem] tracking-[0.12em] uppercase">{item.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>
<script>
  import { initMarquee } from '../../utils/marquee'
  initMarquee('.marquee-track')

  const el = document.getElementById('stats-bar')
  const alreadySeen = sessionStorage.getItem('intro-seen')
  if (el) {
    if (alreadySeen) {
      el.classList.remove('opacity-0', 'translate-y-8', 'invisible')
      el.classList.add('opacity-100', 'translate-y-0', 'visible')
    } else {
      setTimeout(() => {
        el.classList.remove('opacity-0', 'translate-y-8', 'invisible')
        el.classList.add('opacity-100', 'translate-y-0', 'visible')
      }, 6800)
    }
  }
</script>
