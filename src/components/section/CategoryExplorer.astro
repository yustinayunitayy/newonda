---
import type { CategoryExplorerBlock } from '../../lib/data/blocks/category-explorer'
import { resolveColor } from '../../lib/colour'

type Props = CategoryExplorerBlock
const {
  miniLabel,
  labelTextColor,
  heading,
  headingTextColor,
  subheading,
  subheadingTextColor,
  groups = [],
} = Astro.props

const tones = {
  blue: {
    tile: 'bg-onda-blue',
    title: 'text-white',
    chip: 'bg-white text-onda-blue',
    link: 'text-white',
  },
  light: {
    tile: 'bg-light-blue-shade',
    title: 'text-onda-blue',
    chip: 'bg-white text-onda-blue',
    link: 'text-onda-blue',
  },
  yellow: {
    tile: 'bg-light-yellow-shade',
    title: 'text-dark-blue-shade',
    chip: 'bg-onda-yellow/60 text-dark-blue-shade',
    link: 'text-dark-blue-shade',
  },
} as const
---

<section class="section">
  {
    (miniLabel || heading || subheading) && (
      <div class="mb-8 flex flex-col gap-3" data-reveal-group>
        {miniLabel && (
          <p
            class="text-mini-label font-bold tracking-[0.2em]"
            style={`color:${resolveColor(labelTextColor, 'blue')}`}
          >
            {miniLabel}
          </p>
        )}
        {heading && (
          <h2 class="text-h2" style={`color:${resolveColor(headingTextColor, 'blue')}`}>
            {heading}
          </h2>
        )}
        {subheading && (
          <p class="text-body" style={`color:${resolveColor(subheadingTextColor, 'darkBlue')}`}>
            {subheading}
          </p>
        )}
      </div>
    )
  }

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-5" data-reveal-group>
    {
      groups.map((g) => {
        const t = tones[g.tone as keyof typeof tones] ?? tones.light
        const subs = (g.subtypes ?? '')
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean)
        return (
          <a
            id={g.anchorId}
            href={g.linkUrl || '/catalogue'}
            class:list={[
              'cat-tile group flex min-h-44 scroll-mt-28 flex-col justify-between rounded-2xl p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl md:min-h-52 md:p-6',
              t.tile,
            ]}
          >
            <div>
              <h3 class:list={['text-h4 font-bold', t.title]}>{g.title}</h3>
              {subs.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {subs.map((s) => (
                    <li class:list={['rounded-md px-2.5 py-1 text-xs font-bold', t.chip]}>{s}</li>
                  ))}
                </ul>
              )}
            </div>
            <span
              class:list={[
                'mt-4 inline-flex items-center gap-1 text-sm font-semibold transition-transform duration-300 group-hover:translate-x-1',
                t.link,
              ]}
            >
              {g.linkText || 'Lihat di Catalogue'}
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </a>
        )
      })
    }
  </div>
</section>

<style>
  .cat-tile:target {
    outline: 3px solid var(--color-dark-blue-shade);
    outline-offset: 3px;
  }
</style>
