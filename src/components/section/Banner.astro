---
import type { BannerBlock } from '../../lib/data/blocks/banner'
import { textPositionMap, resolveColor } from '../../lib/colour'
import Buttons from './Buttons.astro'
import { img } from '../../lib/image'

type Props = BannerBlock

const {
  miniLabel,
  heading,
  subheading,
  labelTextColor = 'white',
  headingTextColor = 'white',
  subheadingTextColor = 'white',
  textAlign = 'center-center',
  backgroundImage,
  overlayColor = 'black',
  overlayOpacity = 40,
  buttons,
} = Astro.props

const position = textPositionMap[textAlign] ?? textPositionMap['center-center']

const overlayBg =
  overlayColor === 'blue'
    ? 'var(--color-dark-blue-shade)'
    : overlayColor === 'black'
      ? '#000000'
      : null

const clampedOpacity = Math.min(Math.max(overlayOpacity, 0), 100) / 100
---

<section class="relative w-full overflow-hidden overflow-x-clip">
  {
    backgroundImage?.url && (
      <img
        src={img(backgroundImage.url, 1600)}
        alt={backgroundImage.alt ?? heading}
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="lazy"
      />
    )
  }

  {
    overlayBg && (
      <div class="absolute inset-0" style={`background:${overlayBg}; opacity:${clampedOpacity}`} />
    )
  }

  <div
    class="relative z-10 mx-auto flex w-full flex-col px-6 py-16 md:px-24 md:py-24"
    data-reveal="right"
    style={`align-items:${position.alignItems}; gap:${position.gap}`}
  >
    {
      miniLabel && (
        <p class="text-mini-label" style={`color:${resolveColor(labelTextColor, 'white')}`}>
          {miniLabel}
        </p>
      )
    }

    <h2
      class="text-h2"
      style={`text-align:${position.textAlign}; max-width:${position.maxWidth}; color:${resolveColor(headingTextColor, 'white')}`}
    >
      {heading}
    </h2>

    {
      subheading && (
        <p
          class="text-body"
          style={`text-align:${position.textAlign}; max-width:${position.maxWidth}; color:${resolveColor(subheadingTextColor, 'white')}`}
        >
          {subheading}
        </p>
      )
    }
    {
      buttons && buttons.length > 0 && (
        <Buttons buttons={buttons} class="mt-2 flex flex-wrap gap-3" />
      )
    }
  </div>
</section>
