---
import type { BannerBlock } from '../../lib/data/blocks/banner'
import { buttonStyleMap, textPositionMap, textColorMap } from '../../lib/colour'
import { img } from '../../lib/image'

type Props = BannerBlock

const {
  miniLabel,
  heading,
  subheading,
  labelTextColor = 'white',
  headingTextColor = 'white',
  subheadingTextColor = 'white',
  textAlign = 'center-center',
  backgroundImage,
  overlayColor = 'black',
  overlayOpacity = 40,
  buttons,
} = Astro.props

const position = textPositionMap[textAlign] ?? textPositionMap['center-center']

const overlayBg =
  overlayColor === 'blue'
    ? 'var(--color-dark-blue-shade)'
    : overlayColor === 'black'
      ? '#000000'
      : null

const clampedOpacity = Math.min(Math.max(overlayOpacity, 0), 100) / 100

const btnClass =
  'cursor-pointer rounded-xl px-6 py-2 text-sm font-semibold transition-all duration-200'
---

<section class="relative w-full overflow-hidden overflow-x-clip">
  {
    backgroundImage?.url && (
      <img
        src={img(backgroundImage.url, 1600)}
        alt={backgroundImage.alt ?? heading}
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="lazy"
      />
    )
  }

  {
    overlayBg && (
      <div class="absolute inset-0" style={`background:${overlayBg}; opacity:${clampedOpacity}`} />
    )
  }

  <div
    class="max -w-7xl relative z-10 flex w-full flex-col px-6 py-16 md:px-24 md:py-24"
    data-reveal="right"
    style={`align-items:${position.alignItems}; gap:${position.gap}`}
  >
    {
      miniLabel && (
        <p class="text-mini-label" style={`color:${textColorMap[labelTextColor]}`}>
          {miniLabel}
        </p>
      )
    }

    <h2
      class="text-h2"
      style={`text-align:${position.textAlign}; max-width:${position.maxWidth}; color:${textColorMap[headingTextColor]}`}
    >
      {heading}
    </h2>

    {
      subheading && (
        <p
          class="text-body"
          style={`text-align:${position.textAlign}; max-width:${position.maxWidth}; color:${textColorMap[subheadingTextColor]}`}
        >
          {subheading}
        </p>
      )
    }

    {
      buttons && buttons.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-3">
          {buttons.map((btn) => {
            const style = buttonStyleMap[btn.variant] ?? {}
            return btn.buttonType === 'scroll' ? (
              <button data-scroll-target={btn.scrollTarget} class={btnClass} style={style}>
                {btn.text}
              </button>
            ) : (
              <a
                href={btn.url}
                target={btn.openInNewTab ? '_blank' : '_self'}
                rel={btn.openInNewTab ? 'noopener noreferrer' : undefined}
                class={btnClass}
                style={style}
              >
                {btn.text}
              </a>
            )
          })}
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-scroll-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.scrollTarget
      if (target) document.getElementById(target)?.scrollIntoView({ behavior: 'smooth' })
    })
  })
</script>
