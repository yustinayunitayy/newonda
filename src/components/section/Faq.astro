---
import type { FaqBlock } from '../../lib/data/blocks/faq'
import { RichTextRenderer } from '../react/RichTextRenderer'
import { buttonVariants } from '../../lib/colour'

type Props = FaqBlock

const { miniLabel, heading, description, buttonEnabled, buttons, items } = Astro.props

const btn = buttonEnabled ? buttons?.[0] : undefined
const btnBase =
  'inline-flex w-fit items-center gap-2 rounded-xl px-6 py-2.5 text-sm font-semibold cursor-pointer transition-all duration-200 hover:-translate-y-0.5 hover:brightness-110 hover:shadow-lg'
---

<section class="px-10 py-16 md:px-24 md:py-24" data-faq>
  <div class="flex flex-col gap-10 md:flex-row md:gap-20">
    <div class="flex flex-col gap-4 md:sticky md:top-24 md:w-[35%] md:self-start" data-faq-head>
      {miniLabel && <p class="text-mini-label text-dark-blue-shade font-bold">{miniLabel}</p>}
      {heading && <h2 class="text-onda-blue text-h2 leading-tight">{heading}</h2>}
      {description && <p class="text-body text-dark-blue-shade leading-relaxed">{description}</p>}
      {
        btn && (
          <a
            href={btn.url}
            target={btn.openInNewTab ? '_blank' : '_self'}
            rel={btn.openInNewTab ? 'noopener noreferrer' : undefined}
            class={btnBase}
            style={buttonVariants[btn.variant].base}
          >
            {btn.text}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        )
      }
    </div>

    <div class="flex flex-1 flex-col">
      {
        items.map((item, i) => (
          <details
            class="group border-b border-gray-200 px-1 py-5 transition-all duration-200 open:my-2 open:rounded-2xl open:border-b-transparent open:bg-white open:px-6 open:py-6 open:shadow-[0_18px_50px_-20px_rgba(0,36,64,0.25)] open:ring-1 open:ring-gray-100"
            name="faq-accordion"
            data-faq-item
          >
            <summary class="flex cursor-pointer list-none items-start gap-4 [&::-webkit-details-marker]:hidden">
              <span class="text-onda-blue/50 shrink-0 text-lg font-semibold tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-onda-blue text-body flex-1 leading-snug font-semibold">
                {item.question}
              </span>
              <svg
                class="text-onda-blue/40 mt-1 shrink-0 transition-transform duration-200 group-open:rotate-45"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <div class="mt-3 pl-10">
              <RichTextRenderer
                content={item.answer}
                className="text-dark-blue-shade [&_p]:text-sm md:[&_p]:text-base [&_p]:mb-0"
              />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from 'motion'
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-faq]').forEach((section) => {
      const targets = section.querySelectorAll<HTMLElement>('[data-faq-head], [data-faq-item]')
      targets.forEach((el) => (el.style.opacity = '0'))
      inView(section, () => {
        animate(
          targets,
          { opacity: [0, 1], y: [12, 0] },
          { duration: 0.4, delay: stagger(0.06), ease: 'easeOut' }
        )
      })
    })
  }
</script>
