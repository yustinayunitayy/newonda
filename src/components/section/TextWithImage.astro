---
import type { TextWithImageBlock } from '../../lib/data/blocks/text-with-image'
import { resolveColor } from '../../lib/colour'
import Buttons from './Buttons.astro'
import { img } from '../../lib/image'

type Props = TextWithImageBlock

const {
  enableSectionId,
  sectionId,
  layout = 'text-left',
  miniLabel,
  labelTextColor,
  heading,
  headingTextColor = 'blue',
  subheading,
  subheadingTextColor = 'blue',
  body,
  bodyTextColor = 'darkBlue',
  buttonEnabled,
  buttons,
  image,
} = Astro.props

const isTextLeft = layout === 'text-left'
const resolvedId = enableSectionId && sectionId ? sectionId : undefined
---

<section class="section">
  <div
    id={resolvedId}
    class:list={[
      'flex flex-col items-center gap-8 lg:gap-20',
      isTextLeft ? 'lg:flex-row' : 'lg:flex-row-reverse',
    ]}
  >
    <!-- Text side -->
    <div class="flex flex-1 flex-col gap-4" data-reveal-group>
      {
        miniLabel && (
          <p class="text-mini-label" style={`color:${resolveColor(labelTextColor, 'darkBlue')}`}>
            {miniLabel}
          </p>
        )
      }

      <h2 class="text-h2" style={`color:${resolveColor(headingTextColor, 'blue')}`}>{heading}</h2>
      <h3 class="text-h3" style={`color:${resolveColor(subheadingTextColor, 'blue')}`}>
        {subheading}
      </h3>
      {
        body && (
          <p
            class="text-body leading-relaxed whitespace-pre-line"
            style={`color:${resolveColor(bodyTextColor, 'darkBlue')}`}
          >
            {body}
          </p>
        )
      }

      <Buttons buttons={buttons} enabled={buttonEnabled} />
    </div>

    <!-- Image side -->
    {
      image && (
        <div class="w-full flex-1" data-reveal-group>
          <img
            src={img(image.url, 1200)}
            alt={image.alt ?? heading}
            width={image.width}
            height={image.height}
            class="mx-auto h-auto w-full rounded-2xl object-cover shadow-lg"
            loading="lazy"
          />
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-scroll-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.scrollTarget
      if (target) document.getElementById(target)?.scrollIntoView({ behavior: 'smooth' })
    })
  })

  document.querySelectorAll<HTMLElement>('[data-hover]').forEach((el) => {
    const base = el.getAttribute('style') || ''
    const hover = JSON.parse(el.dataset.hover || '{}')
    el.addEventListener('mouseenter', () => Object.assign(el.style, hover))
    el.addEventListener('mouseleave', () => el.setAttribute('style', base))
  })
</script>
