---
import type { TextWithImageBlock } from '../../lib/data/blocks/text-with-image'
import { buttonVariants, textColorMap } from '../../lib/colour'
import { img } from '../../lib/image'

type Props = TextWithImageBlock

const {
  enableSectionId,
  sectionId,
  layout = 'text-left',
  miniLabel,
  labelTextColor,
  heading,
  headingTextColor = 'blue',
  subheading,
  subheadingTextColor = 'blue',
  body,
  bodyTextColor = 'darkBlue',
  buttonEnabled,
  buttons,
  image,
} = Astro.props

const isTextLeft = layout === 'text-left'
const resolvedId = enableSectionId && sectionId ? sectionId : undefined

const btnClass = 'cursor-pointer rounded-xl text-button font-semibold transition-all duration-200'
---

<section class="section">
  <div
    id={resolvedId}
    class:list={[
      'flex flex-col items-center gap-8 lg:gap-20',
      isTextLeft ? 'lg:flex-row' : 'lg:flex-row-reverse',
    ]}
  >
    <!-- Text side -->
    <div class="flex flex-1 flex-col gap-4" data-reveal-group>
      {
        miniLabel && (
          <p
            class="text-mini-label"
            style={labelTextColor ? `color:${textColorMap[labelTextColor]}` : undefined}
          >
            {miniLabel}
          </p>
        )
      }

      <h2 class="text-h2" style={`color:${textColorMap[headingTextColor]}`}>{heading}</h2>
      <h3 class="text-h3" style={`color:${textColorMap[subheadingTextColor]}`}>{subheading}</h3>
      {
        body && (
          <p
            class="text-body leading-relaxed whitespace-pre-line"
            style={`color:${textColorMap[bodyTextColor]}`}
          >
            {body}
          </p>
        )
      }

      {
        buttonEnabled && buttons && buttons.length > 0 && (
          <div class="flex flex-wrap items-center gap-3">
            {buttons.map((btn) => {
              const variant = buttonVariants[btn.variant] ?? {}
              const isTextOnly = btn.variant.endsWith('-text')
              const commonProps = {
                class: `${btnClass} ${isTextOnly ? 'px-0 py-1' : 'px-6 py-2.5'}`,
                style: variant.base,
                'data-hover': JSON.stringify(variant.hover ?? {}),
              }
              return btn.buttonType === 'scroll' ? (
                <button data-scroll-target={btn.scrollTarget} {...commonProps}>
                  {btn.text}
                </button>
              ) : (
                <a
                  href={btn.url}
                  target={btn.openInNewTab ? '_blank' : '_self'}
                  rel={btn.openInNewTab ? 'noopener noreferrer' : undefined}
                  {...commonProps}
                >
                  {btn.text}
                </a>
              )
            })}
          </div>
        )
      }
    </div>

    <!-- Image side -->
    {
      image && (
        <div class="w-full flex-1" data-reveal-group>
          <img
            src={img(image.url, 1200)}
            alt={image.alt ?? heading}
            width={image.width}
            height={image.height}
            class="mx-auto h-auto w-full rounded-2xl object-cover shadow-lg"
            loading="lazy"
          />
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-scroll-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.scrollTarget
      if (target) document.getElementById(target)?.scrollIntoView({ behavior: 'smooth' })
    })
  })

  document.querySelectorAll<HTMLElement>('[data-hover]').forEach((el) => {
    const base = el.getAttribute('style') || ''
    const hover = JSON.parse(el.dataset.hover || '{}')
    el.addEventListener('mouseenter', () => Object.assign(el.style, hover))
    el.addEventListener('mouseleave', () => el.setAttribute('style', base))
  })
</script>
