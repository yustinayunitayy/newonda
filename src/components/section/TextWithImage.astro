---
import { RichTextRenderer } from '../react/RichTextRenderer'
import type { TextWithImageBlock } from '../../lib/data/blocks/text-with-image'
import { buttonStyleMap } from '../../lib/colour'

type Props = TextWithImageBlock

const {
  enableSectionId,
  sectionId,
  layout = 'text-left',
  miniLabel,
  heading,
  body,
  buttonEnabled,
  buttons,
  image,
} = Astro.props

const isTextLeft = layout === 'text-left'
const resolvedId = enableSectionId && sectionId ? sectionId : undefined

const btnClass =
  'cursor-pointer rounded-xl text-sm font-semibold transition-all duration-200'
---

<section class="px-10 py-16 md:px-24 md:py-24">
  <div
    id={resolvedId}
    class:list={[
      'flex flex-col items-center gap-10 md:gap-32',
      isTextLeft ? 'md:flex-row' : 'md:flex-row-reverse',
    ]}
  >
    <!-- Text side -->
    <div class="flex flex-1 flex-col gap-4">
      {miniLabel && <p class="text-mini-label">{miniLabel}</p>}

      <h2 class="text-h2 text-onda-blue">
        {heading}
      </h2>

      {body && <RichTextRenderer content={body} client:load />}

      {
        buttonEnabled && buttons && buttons.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {buttons.map((btn) => {
              const style = buttonStyleMap[btn.variant] ?? {}
              return btn.buttonType === 'scroll' ? (
                <button data-scroll-target={btn.scrollTarget} class={btnClass} style={style}>
                  {btn.text}
                </button>
              ) : (
                <a
                  href={btn.url}
                  target={btn.openInNewTab ? '_blank' : '_self'}
                  rel={btn.openInNewTab ? 'noopener noreferrer' : undefined}
                  class={btnClass}
                  style={style}
                >
                  {btn.text}
                </a>
              )
            })}
          </div>
        )
      }
    </div>

    <!-- Image side -->
    {
      image && (
        <div class="w-full flex-1">
          <img
            src={image.url}
            alt={image.alt ?? heading}
            width={image.width}
            height={image.height}
            class="h-auto w-full rounded-2xl object-cover shadow-lg"
            loading="lazy"
          />
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-scroll-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.scrollTarget
      if (target) document.getElementById(target)?.scrollIntoView({ behavior: 'smooth' })
    })
  })
</script>