---
import RichTextRenderer from './RichTextRenderer.astro'
import type { TextWithImageBlock } from '../../lib/data/blocks/text-with-image'
import { buttonClassMap } from '../../lib/colour'

type Props = TextWithImageBlock

const {
  enableSectionId,
  sectionId,
  layout = 'text-left',
  miniLabel,
  heading,
  body,
  buttonEnabled,
  buttons,
  image,
} = Astro.props

const isTextLeft = layout === 'text-left'
const resolvedId = enableSectionId && sectionId ? sectionId : undefined

const btnBase = 'rounded-xl text-sm font-semibold transition-all duration-200 cursor-pointer'
---

<section class="px-10 py-16 md:px-24 md:py-24">
  <div
    id={resolvedId}
    class:list={[
      'flex scroll-mt-40 flex-col items-center gap-10 md:gap-32',
      isTextLeft ? 'md:flex-row' : 'md:flex-row-reverse',
    ]}
  >
    <!-- Text side -->
    <div class="flex flex-1 flex-col gap-4">
      {
        miniLabel && (
          <p class="text-onda-blue text-xs font-semibold tracking-widest uppercase">{miniLabel}</p>
        )
      }

      <h2 class="text-onda-blue text-xl leading-tight font-bold md:text-4xl">
        {heading}
      </h2>

      {body && <RichTextRenderer content={body} />}

      {
        buttonEnabled && buttons && buttons.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {buttons.map((btn) =>
              btn.buttonType === 'scroll' ? (
                <button
                  data-scroll-target={btn.scrollTarget}
                  class={`${btnBase} ${buttonClassMap[btn.variant]}`}
                >
                  {btn.text}
                </button>
              ) : (
                <a
                  href={btn.url}
                  target={btn.openInNewTab ? '_blank' : '_self'}
                  rel={btn.openInNewTab ? 'noopener noreferrer' : undefined}
                  class={`${btnBase} ${buttonClassMap[btn.variant]}`}
                >
                  {btn.text}
                </a>
              )
            )}
          </div>
        )
      }
    </div>

    <!-- Image side -->
    {
      image && (
        <div class="w-full flex-1">
          <img
            src={image.url}
            alt={image.alt ?? heading}
            width={image.width}
            height={image.height}
            class="h-auto w-full rounded-2xl object-cover shadow-lg"
            loading="lazy"
          />
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-scroll-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.scrollTarget
      if (target) document.getElementById(target)?.scrollIntoView({ behavior: 'smooth' })
    })
  })
</script>
