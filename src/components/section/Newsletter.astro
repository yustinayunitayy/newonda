---
import type { NewsletterBlock } from '../../lib/data/blocks/newsletter'

type Props = NewsletterBlock
const { heading = 'Daftar Newsletter ONDA', subheading } = Astro.props
---

<section class="w-full" data-reveal="right">
  <div
    class="from-light-blue-shade to-light-yellow-shade flex flex-col items-start gap-6 bg-gradient-to-r px-10 py-16 md:flex-row md:items-center md:justify-between md:px-24 md:py-16"
  >
    <div class="max-w-md">
      <h2 class="text-onda-blue text-h2 font-extrabold italic">{heading}</h2>
      {
        subheading && (
          <p class="text-body text-dark-blue-shade mt-2 leading-relaxed">{subheading}</p>
        )
      }
    </div>

    <form id="newsletter-form" class="flex w-full flex-col gap-2 sm:flex-row md:w-auto">
      <input
        type="email"
        name="email"
        required
        placeholder="Masukkan Email Anda"
        class="text-dark-blue-shade w-full rounded-lg border-0 bg-white px-4 py-2.5 text-sm shadow-sm outline-none sm:w-64"
      />
      <button
        type="submit"
        class="bg-onda-blue rounded-lg px-6 py-2.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:brightness-110"
      >
        Subscribe
      </button>
    </form>
  </div>
</section>

<script>
  import Swal from 'sweetalert2'

  const form = document.getElementById('newsletter-form') as HTMLFormElement

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = (form.elements.namedItem('email') as HTMLInputElement).value
    const btn = form.querySelector('button')!
    btn.disabled = true

    Swal.fire({
      title: 'Mendaftar...',
      text: 'Sebentar ya',
      allowOutsideClick: false,
      allowEscapeKey: false,
      didOpen: () => Swal.showLoading(),
    })

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      })

      if (res.ok) {
        const data = await res.json().catch(() => ({}))
        if (data.already) {
          await Swal.fire({
            icon: 'info',
            title: 'Kamu udah subscribe kok 😊',
            text: 'Email ini sudah terdaftar di newsletter kami.',
            confirmButtonText: 'Oke',
            confirmButtonColor: '#0050b3',
          })
        } else {
          await Swal.fire({
            icon: 'success',
            title: 'Berhasil! 🎉',
            text: 'Cek inbox kamu untuk email selamat datang.',
            confirmButtonText: 'Oke',
            confirmButtonColor: '#0050b3',
          })
        }
        form.reset()
      } else {
        const { error } = await res.json().catch(() => ({}))
        await Swal.fire({
          icon: 'error',
          title: 'Gagal subscribe',
          text: error ?? 'Coba lagi sebentar ya.',
          confirmButtonText: 'Oke',
          confirmButtonColor: '#0050b3',
        })
      }
    } catch {
      await Swal.fire({
        icon: 'error',
        title: 'Oops!',
        text: 'Ada masalah koneksi. Coba lagi.',
        confirmButtonText: 'Oke',
        confirmButtonColor: '#0050b3',
      })
    } finally {
      btn.disabled = false
    }
  })
</script>
