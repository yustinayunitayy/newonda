---
import type { NewsletterBlock } from '../../lib/data/blocks/newsletter'
import type { SiteSettings } from '../../lib/data/site-settings'

type Props = NewsletterBlock & { settings?: SiteSettings }
const { heading = 'Daftar Newsletter ONDA', subheading, settings } = Astro.props

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
const csEmail = settings?.contact?.email
---

<section class="w-full overflow-x-clip">
  <div
    class="from-light-blue-shade to-light-yellow-shade flex flex-col items-start gap-6 bg-gradient-to-r px-8 py-12 md:px-12 lg:flex-row lg:items-center lg:justify-between lg:px-24 lg:py-16"
  >
    <div class="max-w-md" data-reveal="right">
      <h2 class="text-onda-blue text-h2 font-extrabold italic">{heading}</h2>
      {
        subheading && (
          <p class="text-body text-dark-blue-shade mt-2 leading-relaxed">{subheading}</p>
        )
      }
    </div>

    <form
      id="newsletter-form"
      data-cs-email={csEmail}
      data-list="newsletter"
      data-source="newsletter-section"
      class="flex w-full flex-col gap-3 md:w-auto"
      data-reveal-delay="150"
    >
      <div class="flex w-full flex-col gap-2 sm:flex-row">
        <input
          type="email"
          name="email"
          required
          placeholder="Masukkan Email Anda"
          class="text-dark-blue-shade w-full rounded-lg border-0 bg-white px-4 py-2.5 text-sm shadow-sm outline-none sm:flex-1 lg:w-64"
        />
        <button
          type="submit"
          class="bg-onda-blue rounded-lg px-6 py-2.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:brightness-110"
        >
          Subscribe
        </button>
      </div>

      <input
        type="text"
        name="_hp"
        tabindex="-1"
        autocomplete="off"
        class="hidden"
        aria-hidden="true"
      />

      <div
        class="cf-turnstile"
        data-sitekey={TURNSTILE_SITE_KEY}
        data-appearance="interaction-only"
        data-size="flexible"
        data-theme="light"
        data-language="id"
      >
      </div>
    </form>
  </div>
</section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  import { attachNewsletter } from '../../lib/newsletter'
  attachNewsletter(document.getElementById('newsletter-form') as HTMLFormElement)
</script>
