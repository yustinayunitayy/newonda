---
import type { NewsletterBlock } from '../../lib/data/blocks/newsletter'

type Props = NewsletterBlock
const { heading = 'Daftar Newsletter ONDA', subheading } = Astro.props
---

<section class="w-full overflow-x-clip">
  <div
    class="from-light-blue-shade to-light-yellow-shade flex flex-col items-start gap-6 bg-gradient-to-r px-8 py-12 md:px-12 lg:flex-row lg:items-center lg:justify-between lg:px-24 lg:py-16"
  >
    <div class="max-w-md" data-reveal="right">
      <h2 class="text-onda-blue text-h2 font-extrabold italic">{heading}</h2>
      {
        subheading && (
          <p class="text-body text-dark-blue-shade mt-2 leading-relaxed">{subheading}</p>
        )
      }
    </div>

    <form
      id="newsletter-form"
      class="flex w-full flex-col gap-2 sm:flex-row md:w-auto"
      data-reveal-delay="150"
    >
      <input
        type="email"
        name="email"
        required
        placeholder="Masukkan Email Anda"
        class="text-dark-blue-shade w-full rounded-lg border-0 bg-white px-4 py-2.5 text-sm shadow-sm outline-none sm:flex-1 lg:w-64"
      />
      <button
        type="submit"
        class="bg-onda-blue rounded-lg px-6 py-2.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:brightness-110"
      >
        Subscribe
      </button>
    </form>
  </div>
</section>
<script>
  import Swal from 'sweetalert2'

  const form = document.getElementById('newsletter-form') as HTMLFormElement

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim()
    const btn = form.querySelector('button')!

    const confirmed = await Swal.fire({
      icon: 'question',
      title: 'Sudah benar?',
      text: `Newsletter akan dikirim ke ${email}`,
      showCancelButton: true,
      confirmButtonText: 'Ya, daftarkan',
      cancelButtonText: 'Perbaiki dulu',
      reverseButtons: true,
    })
    if (!confirmed.isConfirmed) return

    btn.disabled = true
    Swal.fire({
      title: 'Mendaftar...',
      text: 'Sebentar ya',
      allowOutsideClick: false,
      allowEscapeKey: false,
      didOpen: () => Swal.showLoading(),
    })

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      })
      const data = await res.json().catch(() => ({}))

      if (!res.ok) {
        await Swal.fire({
          icon: 'error',
          title: 'Gagal subscribe',
          text: data.error ?? 'Coba lagi sebentar ya.',
          confirmButtonText: 'Oke',
        })
        return
      }

      if (data.status === 'already') {
        await Swal.fire({
          icon: 'info',
          title: 'Kamu sudah terdaftar',
          text: 'Email ini sudah ada di newsletter kami.',
          confirmButtonText: 'Oke',
        })
      } else if (data.status === 'unsubscribed') {
        await Swal.fire({
          icon: 'info',
          title: 'Email ini pernah berhenti berlangganan',
          text: 'Kalau mau berlangganan lagi, hubungi kami di cs@onda.id ya.',
          confirmButtonText: 'Oke',
        })
      } else {
        await Swal.fire({
          icon: 'success',
          title: 'Berhasil!',
          text: 'Cek inbox kamu untuk email selamat datang.',
          confirmButtonText: 'Oke',
        })
        form.reset()
      }
    } catch {
      await Swal.fire({
        icon: 'error',
        title: 'Oops!',
        text: 'Ada masalah koneksi. Coba lagi.',
        confirmButtonText: 'Oke',
      })
    } finally {
      btn.disabled = false
    }
  })
</script>