---
import type { SiteSettings } from '../../lib/data/site-settings'
import type { PopupData } from '../../lib/data/pop-up'
import { img } from '../../lib/image'

interface Props {
  popup: PopupData
  settings?: SiteSettings
}
const { popup, settings } = Astro.props
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
const csEmail = settings?.contact?.email

const isNewsletter = popup?.type === 'newsletter'
const imageUrl = popup?.image?.url ?? ''
const imageAlt = popup?.image?.alt ?? 'Promo ONDA'
const hasImage = !!imageUrl
const show = popup?.active && (isNewsletter || hasImage)
---

{
  show && (
    <div
      id="promo-popup"
      class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 p-4 backdrop-blur-sm"
      data-start={popup.startDate ?? ''}
      data-end={popup.endDate ?? ''}
      data-hideads={popup.hideForAds ? '1' : ''}
    >
      <div class="relative w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl">
        <button
          id="promo-close"
          type="button"
          aria-label="Tutup"
          class="text-onda-blue absolute top-2 right-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 shadow transition hover:scale-105"
        >
          <iconify-icon icon="mdi:close" width="20" />
        </button>

        {hasImage &&
          (isNewsletter || !popup.linkUrl ? (
            <img src={img(imageUrl, 1080)} alt={imageAlt} class="w-full" />
          ) : (
            <a href={popup.linkUrl}>
              <img src={img(imageUrl, 1080)} alt={imageAlt} class="w-full" />
            </a>
          ))}

        {(popup.heading || popup.body || isNewsletter || popup.linkUrl) && (
          <div class="p-5 text-center">
            {popup.heading && <h3 class="text-onda-blue text-lg font-bold">{popup.heading}</h3>}
            {popup.body && <p class="text-body mt-1 text-slate-500">{popup.body}</p>}

            {isNewsletter ? (
              <form
                id="popup-newsletter-form"
                data-cs-email={csEmail}
                data-list="popup"
                data-source={popup.source ?? 'popup'}
                class="mt-4 flex flex-col gap-2"
              >
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="Masukkan email Anda"
                  class="text-dark-blue-shade w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none"
                />
                <input
                  type="text"
                  name="_hp"
                  tabindex="-1"
                  autocomplete="off"
                  class="hidden"
                  aria-hidden="true"
                />
                <div
                  class="cf-turnstile"
                  data-sitekey={TURNSTILE_SITE_KEY}
                  data-appearance="interaction-only"
                  data-size="flexible"
                  data-theme="light"
                  data-language="id"
                />
                <label class="flex items-start gap-2 text-left text-xs text-slate-600">
                  <input
                    type="checkbox"
                    name="newsletter"
                    checked
                    class="accent-onda-blue mt-0.5"
                  />
                  Saya ingin menerima update terbaru dari ONDA melalui email
                </label>
                <button
                  type="submit"
                  class="bg-onda-blue rounded-lg px-6 py-2.5 text-sm font-semibold text-white transition hover:brightness-110"
                >
                  Kirim
                </button>
                <p class="text-[11px] leading-snug text-slate-400">
                  Dengan mengisi form ini, Anda menyetujui{' '}
                  <a href="/privacy-policy" class="underline">
                    Kebijakan Privasi
                  </a>{' '}
                  ONDA.
                </p>
              </form>
            ) : (
              popup.linkUrl && (
                <a
                  href={popup.linkUrl}
                  class="bg-onda-blue mt-4 inline-block rounded-lg px-6 py-2.5 text-sm font-semibold text-white transition hover:brightness-110"
                >
                  {popup.ctaLabel ?? 'Lihat Sekarang'}
                </a>
              )
            )}
          </div>
        )}
      </div>
    </div>
  )
}

{
  show && isNewsletter && (
    <script is:inline>
      {`if (!document.querySelector('script[src*="turnstile/v0/api.js"]')) {
        var ts = document.createElement('script');
        ts.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
        ts.async = true; ts.defer = true;
        document.head.appendChild(ts);
      }`}
    </script>
  )
}

<script>
  import { attachNewsletter } from '../../lib/newsletter'

  const el = document.getElementById('promo-popup')
  if (el) {
    const params = new URLSearchParams(window.location.search)
    const fromAds = ['gclid', 'gclsrc', 'wbraid', 'gbraid'].some((k) => params.has(k))
    const hideForAds = el.dataset.hideads === '1'

    const now = Date.now()
    const start = el.dataset.start ? new Date(el.dataset.start).getTime() : null
    const end = el.dataset.end ? new Date(el.dataset.end).getTime() : null
    const inWindow = (!start || now >= start) && (!end || now <= end)
    const seen = sessionStorage.getItem('onda_promo_seen')

    if (inWindow && !seen && !(hideForAds && fromAds)) {
      setTimeout(() => {
        el.classList.remove('hidden')
        el.classList.add('flex')
        attachNewsletter(document.getElementById('popup-newsletter-form') as HTMLFormElement)
      }, 5500)
    }

    const close = () => {
      el.classList.add('hidden')
      el.classList.remove('flex')
      sessionStorage.setItem('onda_promo_seen', '1')
    }
    document.getElementById('promo-close')?.addEventListener('click', close)
    el.addEventListener('click', (e) => {
      if (e.target === el) close()
    })

    if (inWindow && !seen && !(hideForAds && fromAds)) {
      setTimeout(() => {
        el.classList.remove('hidden')
        el.classList.add('flex')
        attachNewsletter(document.getElementById('popup-newsletter-form') as HTMLFormElement, close)
      }, 5500)
    }
  }
</script>
