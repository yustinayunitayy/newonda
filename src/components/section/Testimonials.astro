---
import { resolveColor } from '../../lib/colour'
import { img } from '../../lib/image'
import type { TestimonialsBlock } from '../../lib/data/blocks/testimonials'

type Props = TestimonialsBlock

const { miniLabel, labelTextColor, heading, headingTextColor, items = [] } = Astro.props
const labelColor = resolveColor(labelTextColor, 'blue')
const headingColor = resolveColor(headingTextColor, 'blue')

const initials = (name: string) =>
  name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0] ?? '')
    .join('')
    .toUpperCase()
---

<section class="section w-full">
  <div class="mb-6">
    {
      miniLabel && (
        <p class="text-mini-label mb-2 font-bold tracking-[0.2em]" style={`color:${labelColor}`}>
          {miniLabel}
        </p>
      )
    }
    {
      heading && (
        <h2 class="text-h2 font-extrabold" style={`color:${headingColor}`}>
          {heading}
        </h2>
      )
    }
  </div>

  <div
    data-testi-track
    class="flex snap-x snap-mandatory [scrollbar-width:none] gap-6 overflow-x-auto scroll-smooth pb-2 [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
  >
    {
      items.map((t) => (
        <figure class="border-onda-blue/15 flex shrink-0 basis-full snap-start flex-col rounded-2xl border bg-white p-6 shadow-sm sm:basis-[calc(50%-12px)] lg:basis-[calc(33.333%-16px)]">
          <div class="flex items-center gap-3">
            {t.avatar?.url ? (
              <img
                src={img(t.avatar.url, 96)}
                alt={t.name}
                loading="lazy"
                class="h-12 w-12 flex-none rounded-full object-cover"
              />
            ) : (
              <div class="bg-light-blue-shade text-onda-blue text-body flex h-12 w-12 flex-none items-center justify-center rounded-full font-bold">
                {initials(t.name)}
              </div>
            )}
            <figcaption>
              <p class="text-dark-blue-shade text-body leading-tight font-bold">{t.name}</p>
              {t.position && <p class="text-dark-blue-shade/60 text-button">{t.position}</p>}
            </figcaption>
          </div>
          <blockquote class="text-dark-blue-shade/80 text-button mt-4 leading-relaxed italic">
            "{t.quote}"
          </blockquote>
        </figure>
      ))
    }
  </div>

  {
    items.length > 1 && (
      <div data-testi-controls class="mt-4 flex items-center justify-center gap-4">
        <button
          type="button"
          data-testi-prev
          aria-label="Sebelumnya"
          class="border-onda-blue/30 text-onda-blue hover:bg-onda-blue flex h-9 w-9 items-center justify-center rounded-full border text-xl leading-none transition-colors hover:text-white"
        >
          ‹
        </button>
        <div class="flex items-center gap-1.5">
          {items.map((_, i) => (
            <button
              type="button"
              data-testi-dot={i}
              aria-label={`Testimoni ${i + 1}`}
              class="bg-onda-blue/30 h-1.5 w-1.5 rounded-full transition-all"
            />
          ))}
        </div>
        <button
          type="button"
          data-testi-next
          aria-label="Berikutnya"
          class="border-onda-blue/30 text-onda-blue hover:bg-onda-blue flex h-9 w-9 items-center justify-center rounded-full border text-xl leading-none transition-colors hover:text-white"
        >
          ›
        </button>
      </div>
    )
  }
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-testi-track]')
  if (track) {
    const items = Array.from(track.children) as HTMLElement[]
    const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-testi-dot]'))
    const step = () => track.clientWidth * 0.9
    let paused = false

    const controls = document.querySelector<HTMLElement>('[data-testi-controls]')
    const hasOverflow = () => track.scrollWidth > track.clientWidth + 8
    const updateControls = () => {
      if (controls) controls.style.display = hasOverflow() ? 'flex' : 'none'
    }
    updateControls()
    window.addEventListener('resize', updateControls)

    const currentIndex = () => {
      let best = 0
      let bestDist = Infinity
      items.forEach((el, i) => {
        const d = Math.abs(el.offsetLeft - track.scrollLeft)
        if (d < bestDist) {
          bestDist = d
          best = i
        }
      })
      return best
    }

    const paintDots = () => {
      const idx = currentIndex()
      dots.forEach((d, i) => {
        d.style.width = i === idx ? '1.25rem' : '0.375rem'
        d.style.opacity = i === idx ? '1' : ''
        d.classList.toggle('bg-onda-blue', i === idx)
        d.classList.toggle('bg-onda-blue/30', i !== idx)
      })
    }

    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        paused = true
        track.scrollTo({ left: items[i].offsetLeft, behavior: 'smooth' })
        setTimeout(() => (paused = false), 4000)
      })
    )

    document
      .querySelector('[data-testi-prev]')
      ?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    document
      .querySelector('[data-testi-next]')
      ?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))

    track.addEventListener('scroll', () => requestAnimationFrame(paintDots), { passive: true })
    track.addEventListener('mouseenter', () => (paused = true))
    track.addEventListener('mouseleave', () => (paused = false))
    track.addEventListener('touchstart', () => (paused = true), { passive: true })
    track.addEventListener('touchend', () => setTimeout(() => (paused = false), 3000), {
      passive: true,
    })

    setInterval(() => {
      if (paused || !hasOverflow()) return
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8
      if (atEnd) track.scrollTo({ left: 0, behavior: 'smooth' })
      else track.scrollBy({ left: step(), behavior: 'smooth' })
    }, 4000)

    paintDots()
  }
</script>
