---
import type { TimelineBlock } from '../../lib/data/blocks/about'
import { textColorMap } from '../../lib/colour'

type Props = TimelineBlock

const {
  heading,
  headingTextColor = 'blue',
  subheading,
  subheadingTextColor = 'darkBlue',
  events = [],
} = Astro.props
---

<section class="section">
  <!-- Header -->
  {
    (heading || subheading) && (
      <div class="mb-12 text-center">
        {heading && (
          <h2
            class="text-h2 font-extrabold"
            style={`color:${textColorMap[headingTextColor]}`}
            data-reveal
          >
            {heading}
          </h2>
        )}
        {subheading && (
          <p
            class="text-body mt-3 leading-relaxed"
            style={`color:${textColorMap[subheadingTextColor]}`}
            data-reveal
          >
            {subheading}
          </p>
        )}
      </div>
    )
  }

  <!-- Timeline -->
  <div class="relative">
    <div
      class="bg-light-blue-shade absolute top-4 bottom-4 left-[5.5rem] w-0.5 -translate-x-1/2 md:left-[8.75rem]"
    >
    </div>

    <div class="flex flex-col gap-12">
      {
        events.map((e, i) => {
          const finale = i === events.length - 1
          return (
            <div
              class="grid grid-cols-[4.5rem_2rem_1fr] items-center md:grid-cols-[7.5rem_2.5rem_1fr]"
              data-reveal
            >
              {/* tahun gede */}
              <div class="pr-1 text-right">
                <span
                  class:list={[
                    'text-2xl leading-none font-extrabold tabular-nums md:text-5xl',
                    finale ? 'text-onda-blue' : 'text-onda-blue/30',
                  ]}
                >
                  {e.year}
                </span>
              </div>

              {/* dot di tengah */}
              <div class="flex justify-center">
                <span
                  class:list={[
                    'relative z-10 h-4 w-4 rounded-full border-4 border-white',
                    finale ? 'bg-onda-blue' : 'bg-onda-blue/50',
                  ]}
                />
              </div>

              {/* card */}
              <div
                class:list={[
                  'rounded-2xl p-4 shadow-[0_14px_38px_rgba(0,93,166,0.1)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_22px_54px_rgba(0,93,166,0.2)] md:p-8',
                  finale ? 'bg-onda-blue' : 'border-light-blue-shade border bg-white',
                ]}
              >
                <div class="mb-2.5 flex items-center gap-3.5">
                  <div
                    class:list={[
                      'flex h-11 w-11 flex-none items-center justify-center rounded-[14px]',
                      finale ? 'bg-white/20 text-white' : 'bg-light-blue-shade text-onda-blue',
                    ]}
                  >
                    <iconify-icon icon={e.icon} width="22" />
                  </div>
                  <h3
                    class:list={[
                      'text-h3 leading-snug font-bold',
                      finale ? 'text-white' : 'text-onda-blue',
                    ]}
                  >
                    {e.title}
                  </h3>
                </div>
                {e.description && (
                  <p
                    class:list={[
                      'text-body leading-relaxed',
                      finale ? 'text-white/90' : 'text-slate-500',
                    ]}
                  >
                    {e.description}
                  </p>
                )}
              </div>
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<script is:inline src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
