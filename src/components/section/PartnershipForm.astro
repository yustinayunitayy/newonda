---
import type { SiteSettings, FormBlock } from '../../lib/data/site-settings'

type Props = FormBlock & { settings: SiteSettings }
const { miniLabel, heading, body, settings } = Astro.props
const waNumber = settings.contact?.csPhone?.replace(/\D/g, '') ?? ''

const inputClass =
  'w-full rounded-lg border border-light-blue-shade bg-white px-4 py-3 text-sm text-dark-blue-shade placeholder:text-onda-blue/70 focus:border-onda-blue focus:outline-none focus:ring-2 focus:ring-onda-blue/20 transition'
const selectChevron =
  "background-image:url(\"data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='%23005da6' stroke-width='2'%3e%3cpath stroke-linecap='round' stroke-linejoin='round' d='M19 9l-7 7-7-7'/%3e%3c/svg%3e\")"
const partnershipTypes = ['Agen Teknik', 'Agen Bangunan', 'PDAM', 'Dept. Store', 'Lainnya']
---

<section class="section">
  <div class="overflow-hidden rounded-2xl bg-white shadow-xl" data-reveal>
    <div class="grid gap-8 p-6 md:grid-cols-2 md:gap-10 md:p-10">
      <div>
        {
          miniLabel && (
            <p class="text-onda-blue text-mini-label font-bold tracking-[0.2em]">{miniLabel}</p>
          )
        }
        <h2 class="text-onda-blue text-h2 mt-1 font-extrabold">{heading}</h2>
        {
          body && (
            <p class="text-dark-blue-shade/70 text-button mt-3 leading-relaxed whitespace-pre-line">
              {body}
            </p>
          )
        }
      </div>

      <!-- kanan: form -->
      <form id="partnership-form" data-wa={waNumber} class="flex flex-col gap-4">
        <input
          type="text"
          name="_hp"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />
        <div class="grid gap-4 sm:grid-cols-2">
          <input
            class={inputClass}
            type="text"
            name="name"
            required
            minlength="2"
            placeholder="Nama Lengkap"
          />
          <input class={inputClass} type="email" name="email" required placeholder="Email Aktif" />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <input
            class={inputClass}
            type="tel"
            name="phone"
            required
            inputmode="numeric"
            pattern="[0-9]{8,15}"
            maxlength="15"
            placeholder="No. WA / Telp"
          />
          <input
            class={inputClass}
            type="text"
            name="company"
            placeholder="Nama Perusahaan / Toko"
          />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <input class={inputClass} type="text" name="area" placeholder="Area (Kota/Kab)" />
          <input class={inputClass} type="text" name="industri" placeholder="Industri" />
        </div>
        <select
          name="jenis"
          required
          class={`${inputClass} appearance-none bg-[length:1.25rem] bg-[right_0.75rem_center] bg-no-repeat`}
          style={selectChevron}
        >
          <option value="" disabled selected>Pilih jenis kemitraan</option>
          {partnershipTypes.map((t) => <option value={t}>{t}</option>)}
        </select>
        <textarea
          class={`${inputClass} resize-none`}
          name="message"
          rows="3"
          placeholder="Ceritakan singkat tentang bisnis Anda"></textarea>
        <button
          type="submit"
          class="bg-onda-blue hover:bg-dark-blue-shade mt-1 cursor-pointer rounded-lg py-3 text-sm font-bold text-white transition"
        >
          Kirim & Lanjut di Whatsapp
        </button>
      </form>
    </div>
  </div>
</section>
<style>
  #partnership-form select:invalid {
    color: color-mix(in oklab, var(--color-onda-blue) 70%, transparent);
  }
</style>
<script>
  import { initWaForm } from '../../lib/wa-form'
  initWaForm(
    'partnership-form',
    (get) => {
      const lines = [
        get('name') && `*Nama:* ${get('name')}`,
        get('email') && `*Email:* ${get('email')}`,
        get('phone') && `*No. WA/Telp:* ${get('phone')}`,
        get('company') && `*Perusahaan/Toko:* ${get('company')}`,
        get('area') && `*Area:* ${get('area')}`,
        get('industri') && `*Industri:* ${get('industri')}`,
        get('jenis') && `*Jenis Kemitraan:* ${get('jenis')}`,
        get('message') && `*Pesan:* ${get('message')}`,
      ].filter(Boolean)
      const opening = '*PENGAJUAN KEMITRAAN*\nHalo ONDA, saya tertarik menjadi mitra distribusi.'
      return `${opening}\n\n${lines.join('\n')}`
    },
    'Pengajuanmu sudah otomatis disiapkan.<br/>Tinggal tekan tombol <b>Kirim</b> di WhatsApp ya 🙏',
    'mitra'
  )
</script>
