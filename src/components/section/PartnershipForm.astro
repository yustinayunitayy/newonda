---
import type { SiteSettings, FormBlock } from '../../lib/data/site-settings'

type Props = FormBlock & { settings?: SiteSettings }
const { miniLabel, heading, body } = Astro.props

const inputClass =
  'w-full rounded-lg border border-light-blue-shade bg-white px-4 py-3 text-sm text-dark-blue-shade placeholder:text-onda-blue/70 focus:border-onda-blue focus:outline-none focus:ring-2 focus:ring-onda-blue/20 transition'
const selectChevron =
  "background-image:url(\"data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='%23005da6' stroke-width='2'%3e%3cpath stroke-linecap='round' stroke-linejoin='round' d='M19 9l-7 7-7-7'/%3e%3c/svg%3e\")"
const partnershipTypes = ['Agen Teknik', 'Agen Bangunan', 'PDAM', 'Department Store']
---

<section class="section">
  <div class="overflow-hidden rounded-2xl bg-white shadow-xl" data-reveal>
    <div class="grid gap-8 p-6 md:grid-cols-2 md:gap-10 md:p-10">
      <div>
        {
          miniLabel && (
            <p class="text-onda-blue text-mini-label font-bold tracking-[0.2em]">{miniLabel}</p>
          )
        }
        <h2 class="text-onda-blue text-h2 mt-1 font-extrabold">{heading}</h2>
        {
          body && (
            <p class="text-dark-blue-shade/70 text-button mt-3 leading-relaxed whitespace-pre-line">
              {body}
            </p>
          )
        }
      </div>

      <!-- kanan: form -->
      <form id="partnership-form" class="flex flex-col gap-4">
        <input
          type="text"
          name="_hp"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />
        <div class="grid gap-4 sm:grid-cols-2">
          <input
            class={inputClass}
            type="text"
            name="name"
            required
            minlength="2"
            placeholder="Nama Lengkap"
          />
          <input class={inputClass} type="email" name="email" required placeholder="Email Aktif" />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <input
            class={inputClass}
            type="tel"
            name="phone"
            required
            inputmode="numeric"
            pattern="[0-9]{9,15}"
            maxlength="15"
            placeholder="No. WA (cth: 08123456789 / 6512345678)"
          />
          <input
            class={inputClass}
            type="text"
            name="company"
            placeholder="Nama Perusahaan / Toko"
          />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="relative" id="area-combo">
            <input
              class={`${inputClass} text-onda-blue cursor-pointer appearance-none bg-[length:1.25rem] bg-[right_0.75rem_center] bg-no-repeat`}
              style={selectChevron}
              type="text"
              name="area"
              placeholder="Pilih Kab/Kota"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
            />
            <ul
              class="border-light-blue-shade absolute z-20 mt-1 hidden max-h-56 w-full overflow-auto rounded-lg border bg-white shadow-lg"
              role="listbox"
            >
            </ul>
          </div>
          <input
            class={inputClass}
            type="text"
            name="industri"
            placeholder="Industri (Contoh: pabrik, dll.)"
          />
        </div>
        <fieldset>
          <legend class="text-onda-blue/70 mb-2 text-sm">Jenis Kemitraan</legend>
          <div class="flex flex-wrap justify-between gap-y-3">
            {
              partnershipTypes.map((t) => (
                <label class="text-onda-blue/70 flex cursor-pointer items-center gap-2 text-sm">
                  <input type="radio" name="jenis" value={t} required class="peer sr-only" />
                  <span class="border-onda-blue/40 peer-checked:border-onda-blue after:bg-onda-blue relative h-4 w-4 rounded-full border-2 transition after:absolute after:top-1/2 after:left-1/2 after:h-2 after:w-2 after:-translate-x-1/2 after:-translate-y-1/2 after:rounded-full after:opacity-0 after:content-[''] peer-checked:after:opacity-100" />
                  {t}
                </label>
              ))
            }
          </div>
        </fieldset>
        <textarea
          class={`${inputClass} resize-none`}
          name="message"
          rows="3"
          placeholder="Ceritakan singkat tentang bisnis Anda (contoh: item terlaris Anda)"
        ></textarea>
        <button
          type="submit"
          class="bg-onda-blue hover:bg-dark-blue-shade mt-1 cursor-pointer rounded-lg py-3 text-sm font-bold text-white transition disabled:opacity-60"
        >
          Kirim Pengajuan
        </button>
      </form>
    </div>
  </div>
</section>
<script>
  import kabkota from '../../lib/data/kabkota.json'
  import Swal from 'sweetalert2'
  import { toIdPhone } from '../../utils/phone'
  const form = document.getElementById('partnership-form') as HTMLFormElement | null
  if (form) {
    const phone = form.querySelector<HTMLInputElement>('input[name="phone"]')
    phone?.addEventListener('input', () => {
      phone.value = phone.value.replace(/\D/g, '')
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!form.checkValidity()) {
        form.reportValidity()
        return
      }

      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')
      if (phone) phone.value = toIdPhone(phone.value)
      const data = new FormData(form)
      const payload: Record<string, string> = { page: location.pathname }
      data.forEach((v, k) => (payload[k] = v.toString()))

      if (btn) btn.disabled = true
      Swal.fire({ title: 'Mengirim…', allowOutsideClick: false, didOpen: () => Swal.showLoading() })

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
        const out = await res.json().catch(() => ({}))
        if (!res.ok || !out.ok) throw new Error(out.error || 'Gagal mengirim, coba lagi.')

        form.reset()
        Swal.fire({
          icon: 'success',
          title: 'Terkirim! 🎉',
          html: 'Pengajuan kemitraanmu sudah kami terima.<br/>Tim ONDA akan menghubungi kamu dalam <b>2×24 jam</b> ya 🙏',
          confirmButtonText: 'Oke, mengerti',
        })
      } catch (err) {
        Swal.fire({
          icon: 'error',
          title: 'Gagal Mengirim',
          text: (err as Error).message,
          confirmButtonText: 'Coba lagi',
        })
      } finally {
        if (btn) btn.disabled = false
      }
    })
  }

  const combo = document.getElementById('area-combo')
  if (combo) {
    const input = combo.querySelector('input') as HTMLInputElement
    const list = combo.querySelector('ul') as HTMLUListElement
    const DATA = kabkota as string[]

    const close = () => {
      list.classList.add('hidden')
      input.setAttribute('aria-expanded', 'false')
    }
    const render = (items: string[]) => {
      if (!items.length) return close()
      list.innerHTML = items
        .slice(0, 60)
        .map(
          (x) =>
            `<li role="option" class="text-dark-blue-shade hover:bg-light-blue-shade cursor-pointer px-4 py-2 text-sm">${x}</li>`
        )
        .join('')
      list.classList.remove('hidden')
      input.setAttribute('aria-expanded', 'true')
    }
    const open = () => {
      const q = input.value.trim().toLowerCase()
      render(q ? DATA.filter((x) => x.toLowerCase().includes(q)) : DATA)
    }

    input.addEventListener('focus', open)
    input.addEventListener('input', open)
    list.addEventListener('mousedown', (e) => {
      const t = e.target as HTMLElement
      if (t.tagName === 'LI') {
        input.value = t.textContent || ''
        close()
      }
    })
    input.addEventListener('blur', () => setTimeout(close, 120))
  }
</script>
