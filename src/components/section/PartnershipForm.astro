---
import type { SiteSettings, FormBlock } from '../../lib/data/site-settings'
import { textColorMap } from '../../lib/colour'

type Props = FormBlock & { settings: SiteSettings }

const { miniLabel, labelTextColor, heading, headingTextColor, body, bodyTextColor, settings } =
  Astro.props

const waNumber = settings.contact?.csPhone?.replace(/\D/g, '') ?? ''

const labelColor = textColorMap[labelTextColor]
const headingColor = textColorMap[headingTextColor]
const bodyColor = textColorMap[bodyTextColor]

const inputClass =
  'w-full rounded-lg border border-light-blue-shade bg-white px-4 py-3 text-sm text-dark-blue-shade placeholder:text-onda-blue/80 focus:border-onda-blue focus:outline-none focus:ring-2 focus:ring-onda-blue/20 transition'

const partnershipTypes = ['Agen Teknik', 'Agen Bangunan', 'PDAM', 'Dept. Store', 'Lainnya']
---

<section
  class="section-full from-onda-blue to-dark-blue-shade relative -mt-20 overflow-hidden bg-linear-to-b md:-mt-28"
>
  <div class="section">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        {
          miniLabel && (
            <p class="mb-4 text-sm font-bold tracking-[0.2em]" style={`color:${labelColor}`}>
              {miniLabel}
            </p>
          )
        }
        <h2
          class="text-h2 mb-5 max-w-sm font-extrabold text-shadow-lg"
          style={`color:${headingColor}`}
        >
          {heading}
        </h2>
        {
          body && (
            <p class="text-body leading-relaxed whitespace-pre-line" style={`color:${bodyColor}`}>
              {body}
            </p>
          )
        }
      </div>

      <!-- Kanan: form (hardcode) -->
      <div class="shadow-onda-blue/50 rounded-2xl bg-white p-6 shadow-lg md:p-8" data-reveal>
        <form id="partnership-form" data-wa={waNumber} class="flex flex-col gap-4">
          <input type="text" name="_hp" tabindex="-1" autocomplete="off" class="hidden" />

          <input
            class={inputClass}
            type="text"
            name="name"
            required
            minlength="2"
            data-label="Nama"
            placeholder="Nama Lengkap"
            title="Masukkan nama lengkap Anda"
          />
          <input
            class={inputClass}
            type="email"
            name="email"
            required
            data-label="Email"
            placeholder="Email Aktif"
            title="Masukkan alamat email yang valid"
          />
          <input
            class={inputClass}
            type="tel"
            name="phone"
            required
            inputmode="numeric"
            pattern="[0-9]{8,15}"
            maxlength="15"
            data-label="No. WA / Telp"
            placeholder="No. WA / Telp Aktif"
            title="Nomor hanya boleh angka, 8–15 digit"
          />
          <input
            class={inputClass}
            type="text"
            name="company"
            data-label="Perusahaan / Toko"
            placeholder="Nama Perusahaan / Toko"
          />

          <div class="grid gap-4 sm:grid-cols-2">
            <input
              class={inputClass}
              type="text"
              name="area"
              data-label="Area"
              placeholder="Area (Kota/Kab)"
            />
            <input
              class={inputClass}
              type="text"
              name="industri"
              data-label="Industri"
              placeholder="Industri"
            />
          </div>
          <fieldset>
            <legend class="text-onda-blue mb-2 text-base tracking-wide">Jenis Kemitraan</legend>
            <div class="flex flex-wrap gap-x-5 gap-y-2">
              {
                partnershipTypes.map((type, i) => (
                  <label class="text-onda-blue flex cursor-pointer items-center gap-2 text-sm">
                    <input
                      type="radio"
                      name="jenis"
                      value={type}
                      checked={i === 0}
                      class="border-onda-blue checked:border-onda-blue checked:bg-onda-blue h-4 w-4 flex-none appearance-none rounded-full border-2 transition checked:shadow-[inset_0_0_0_3px_white]"
                    />
                    {type}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <textarea
            class={`${inputClass} resize-none`}
            name="message"
            rows="4"
            data-label="Pesan"
            placeholder="Pesan"></textarea>

          <button
            type="submit"
            class="bg-onda-blue hover:bg-dark-blue-shade mt-1 cursor-pointer rounded-lg py-3 text-sm font-bold text-white transition"
          >
            Kirim
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import Swal from 'sweetalert2'

  const form = document.getElementById('partnership-form') as HTMLFormElement | null
  const phone = form?.querySelector<HTMLInputElement>('input[name="phone"]')
  phone?.addEventListener('input', () => {
    phone.value = phone.value.replace(/\D/g, '')
  })

  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    if (!form.checkValidity()) {
      form.reportValidity()
      return
    }

    const wa = form.dataset.wa
    if (!wa) {
      Swal.fire({
        icon: 'error',
        title: 'Nomor WhatsApp belum diset',
        text: 'Hubungi admin untuk melengkapi kontak.',
        confirmButtonColor: '#0050b3',
      })
      return
    }

    const data = new FormData(form)
    const get = (name: string) => (data.get(name) || '').toString().trim()

    const lines = [
      get('name') && `*Nama:* ${get('name')}`,
      get('email') && `*Email:* ${get('email')}`,
      get('phone') && `*No. WA/Telp:* ${get('phone')}`,
      get('company') && `*Perusahaan/Toko:* ${get('company')}`,
      get('area') && `*Area:* ${get('area')}`,
      get('industri') && `*Industri:* ${get('industri')}`,
      get('jenis') && `*Jenis Kemitraan:* ${get('jenis')}`,
      get('message') && `*Pesan:* ${get('message')}`,
    ].filter(Boolean)

    const opening = '*PENGAJUAN KEMITRAAN*\nHalo ONDA, saya tertarik menjadi mitra distribusi.'
    const text = `${opening}\n\n${lines.join('\n')}`
    window.open(`https://wa.me/${wa}?text=${encodeURIComponent(text)}`, '_blank')

    Swal.fire({
      icon: 'success',
      title: 'Mengarahkan ke WhatsApp...',
      html: 'Pengajuanmu sudah otomatis disiapkan.<br/>Tinggal tekan tombol <b>Kirim</b> di WhatsApp ya 🙏',
      confirmButtonText: 'Oke, mengerti',
      confirmButtonColor: '#0050b3',
    })

    form.reset()
  })
</script>
