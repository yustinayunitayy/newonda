---
import '../styles/global.css'
import '../styles/base.css'
import SEO from '../components/seo/SEO.astro'
import JsonLd from '../components/seo/JsonLd.astro'
import GlobalLoader from '../components/global/GlobalLoader.astro'
import { resolveSeo } from '../lib/data/seo-fetch'
import GTMHeader from '../components/seo/GTMHeader.astro'
import GTMBody from '../components/seo/GTMBody.astro'
import Footer from '../components/global/Footer.astro'
import { fetchSiteSettings } from '../lib/data/site-settings'
const settings = await fetchSiteSettings()

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noIndex?: boolean
  footerVariant?: 'blue' | 'black'
}

const { title, description, ogImage, noIndex = false, footerVariant = 'blue' } = Astro.props
const isHome = Astro.url.pathname === '/'

const seo = await resolveSeo({ title, description, ogImage })
---

<!doctype html>
<html lang="id">
  <head>
    <GTMHeader />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />
    <SEO {...seo} {noIndex} />
    <JsonLd title={seo.title} description={seo.description} />
  </head>

  <body class="flex min-h-svh flex-col">
    <GTMBody />
    <GlobalLoader isHome={isHome} />
    <main class="flex-1">
      <slot />
    </main>
    {settings && <Footer settings={settings} variant={footerVariant} />}

    <script>
      function show(el: HTMLElement, delay: number) {
        el.style.transitionDelay = delay + 'ms'
        el.classList.add('is-visible')
      }
      function hide(el: HTMLElement) {
        el.classList.remove('is-visible')
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const el = e.target as HTMLElement
            const isGroup = el.hasAttribute('data-reveal-group')

            if (e.isIntersecting) {
              if (isGroup) {
                Array.from(el.children).forEach((child, i) => show(child as HTMLElement, i * 100))
              } else {
                show(el, Number(el.dataset.revealDelay ?? 0))
              }
            } else {
              if (isGroup) {
                Array.from(el.children).forEach((child) => hide(child as HTMLElement))
              } else {
                hide(el)
              }
            }
          })
        },
        { threshold: 0.15 }
      )

      document
        .querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group]')
        .forEach((el) => io.observe(el))
    </script>
  </body>
</html>
